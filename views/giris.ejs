<%#
  Expected data (all optional):
  not      string   reason for the redirect, e.g. "Oy vermek için giriş yapman gerekiyor." ("You need to log in to vote.")
  hata     string   e.g. "Kullanıcı adı ya da şifre yanlış." ("Wrong username or password.")
  degerler { kullanici_adi }   to keep the form filled after an error
  don      string   address to return to after login

  Beklenen veriler (hepsi isteğe bağlı):
  not      string   yönlendirme sebebi, örn. "Oy vermek için giriş yapman gerekiyor."
  hata     string   örn. "Kullanıcı adı ya da şifre yanlış."
  degerler { kullanici_adi }   hata sonrası formu dolu tutmak için
  don      string   girişten sonra dönülecek adres
%>
<%- include("partials/bas", { sade: true, baslik: "Giriş yap" }) %>
<% const d = locals.degerler || {}; %>
<div class="orta-sayfa">
  <%- include("partials/kontur") %>
  <a class="logo" href="/"><span class="logo-isaret"><img src="/img/marka/rakun-96.webp" alt="" width="32" height="32"></span>rubyyard</a>
  <form class="kart form-karti" method="post" action="/giris"><input type="hidden" name="_csrf" value="<%= locals.csrf %>">
    <h1>Giriş yap</h1>
    <% if (locals.not) { %><div class="bilgi-notu"><%- include("partials/ikon", { ad: "bilgi", boyut: 18 }) %><span><%= not %></span></div><% } %>
    <% if (locals.hata) { %><div class="bilgi-notu hata-notu" role="alert"><%- include("partials/ikon", { ad: "uyari", boyut: 18 }) %><span><%= hata %></span></div><% } %>
    <input type="hidden" name="don" value="<%= locals.don || '/' %>">
    <label class="alan"><span>Kullanıcı adı veya e-posta</span>
      <input name="kullanici_adi" value="<%= d.kullanici_adi || '' %>" autocomplete="username" required autofocus>
    </label>
    <label class="alan"><span>Şifre</span>
      <input type="password" name="sifre" autocomplete="current-password" required>
    </label>
    <div class="satir">
      <label class="onay bosluk"><input type="checkbox" name="hatirla" checked> Beni hatırla</label>
      <a class="baglanti kucuk" href="/sifremi-unuttum">Şifremi unuttum</a>
    </div>
    <button class="buton buton-birincil buton-genis">Giriş yap</button>
    <p class="orta-yazi">Hesabın yok mu? <a href="/kayit">Kayıt ol</a></p>
  </form>
</div>
<%- include("partials/son", { sade: true }) %>
