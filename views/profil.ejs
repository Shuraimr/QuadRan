<%#
  Beklenen veriler:
  profil   { username, bio, avatar_url, banner_url, rol, created_at, points, rutbe,
             konu_sayisi, mesaj_sayisi, alinan_oy }
  rutbeler [ { id, name, min_points, renk, simge, ... } ]   min_points'e göre küçükten büyüğe (ranks tablosu)
  simdiki  profilin rütbesi (rutbeler'den biri), sonraki  bir sonraki rütbe ya da undefined (en üst rütbe)
  acilacaklar [ { etiket } ]   sonraki rütbede YENİ açılan ayrıcalıklar (kilitli kutuda gösterilir)
  puanGecmisi [ { id, miktar, sebep, created_at, konu_id, mesaj_konu_id, mesaj_id, rozet } ]   yalnızca sekme "puan" (kendi profili)
  konular  [ gönderi kartı verisi ]    partials/gonderi-karti ile aynı alanlar
  rozetler [ { name } ]
  haftalik [ { gun: "Pzt", sayi: 2, bugun: false } ]   7 eleman, Pazartesi'den Pazar'a
  konum, web_sitesi  (profil içinde, isteğe bağlı) meta satırında gösterilir
  mesajAtabilir (bool), engelledim (bool)  ziyaretçi için: "Mesaj gönder" görünsün mü, menüde Engelle mi Engeli kaldır mı
  kendisi  bool   giriş yapan kişi kendi profiline mi bakıyor
  sekme    "konular" | "yorumlar" | "puan"   hangi sekme açık (?sekme=yorumlar | puan; puan yalnızca kendi profilinde)
  yorumlar [ { id, content, created_at, konu_id, konu_baslik } ]   yalnızca sekme "yorumlar" iken (ilk mesajlar değil, cevaplar)
%>
<%- include("partials/bas", { baslik: profil.username }) %>
<%- include("partials/ust-cubuk") %>
<%
  // Sekme verilmediyse (örn. /onizleme/profil) Konular açık sayılır; tanımsız değişken sayfayı çökertmesin
  const sekme = ["yorumlar", "puan"].includes(locals.sekme) ? locals.sekme : "konular";
  // Rütbe ilerlemesi: şimdiki rütbenin eşiğinden sonrakinin eşiğine doğru dolgu oranı (en üst rütbede tam dolu)
  const oran = sonraki ? Math.min(1, Math.max(0, (profil.points - simdiki.min_points) / (sonraki.min_points - simdiki.min_points))) : 1;
  const enCok = Math.max(1, ...haftalik.map(g => g.sayi));
  const toplam = haftalik.reduce((t, g) => t + g.sayi, 0);
%>
<div class="profil">
  <%# Üst bölüm: banner + kimlik. Profil rengi/efekti/süsü kişi premium'dayken gelir (sorgu premium değilse NULL döndürür).
      Renkler sunucuda #rrggbb doğrulanır. Arka efekt katmanı banner'ın içinde, ön efekt katmanı bütün üst bölümün üstünde oynar. %>
  <div class="profil-ust" data-efekt="<%= profil.profil_efekti || '' %>"<%- Number(profil.profil_renk_gecis) ? " data-gecis" : "" %> style="<%= profil.profil_renk_ana ? '--pk-ana:' + profil.profil_renk_ana + ';' : '' %><%= profil.profil_renk_vurgu ? '--pk-vurgu:' + profil.profil_renk_vurgu : '' %>">
    <div class="banner" data-konum="<%= profil.banner_konum || 'orta' %>">
      <% if (profil.banner_url) { %><img src="<%= profil.banner_url %>" alt="" decoding="async"><% } else if (!profil.profil_renk_ana) { %><%- include("partials/kontur") %><% } %>
      <%- include("partials/profil-efekt", { efekt: profil.profil_efekti, katman: "arka" }) %>
    </div>
    <div class="kimlik">
      <%- include("partials/avatar", { ad: profil.username, url: profil.avatar_url, sus: profil.avatar_susu, sinif: "avatar-buyuk", oynat: true, bos: true }) %>
      <div class="kimlik-bilgi">
        <div class="satir"><h1><%= profil.username %></h1><% if (profil.rutbe) { %><%- include("partials/rutbe", { rutbeAd: profil.rutbe, rutbeId: profil.rutbe_id }) %><% } %></div>
        <div class="satir ikincil kucuk kimlik-meta">
          <span class="meta-oge"><%- include("partials/ikon", { ad: "takvim", boyut: 16 }) %> <%= profil.rol %> · <%= new Date(profil.created_at).toLocaleDateString("tr-TR", { month: "long", year: "numeric" }) %> tarihinden beri üye</span>
          <% if (profil.konum) { %><span class="meta-oge"><%- include("partials/ikon", { ad: "konum", boyut: 16 }) %> <%= profil.konum %></span><% } %>
          <%# Kullanıcının yazdığı adres: yalnızca http(s) kabul edilir (hesap.ts); arama motorlarına güven aktarma (nofollow ugc) ve yeni sekmede güvenli aç (noopener) %>
          <% if (profil.web_sitesi) { %><a class="meta-oge baglanti" href="<%= profil.web_sitesi %>" rel="nofollow noopener ugc" target="_blank"><%- include("partials/ikon", { ad: "baglanti", boyut: 16 }) %> <%= profil.web_sitesi.replace(/^https?:\/\//i, "").replace(/\/$/, "") %></a><% } %>
        </div>
      </div>
      <div class="satir">
        <% if (locals.kullanici && ["admin", "moderator"].includes(locals.kullanici.rol)) { %>
          <a class="buton buton-cerceveli" href="/yonetim/uyeler/<%= profil.id %>">Yönetimde aç</a>
        <% } %>
        <% if (kendisi) { %>
          <a class="buton buton-tonal" href="/ayarlar">Profili düzenle</a>
          <a class="buton buton-cerceveli" href="/profil/<%= profil.username %>" data-paylas data-baslik="<%= profil.username %> · QuadRan">Paylaş</a>
        <% } else { %>
          <% if (locals.kullanici) { %>
            <% if (locals.mesajAtabilir) { %><a class="buton buton-birincil" href="/mesajlar/<%= profil.username %>">Mesaj gönder</a><% } %>
            <%# Engelle ve Şikâyet et tek ⋮ menüsünde (ayrı bir "Şikâyet et" düğmesi yok: aynı eylem iki yerde durmasın) %>
            <button class="buton buton-cerceveli profil-menu-dugme" type="button" popovertarget="profil-menusu" data-menu-ac aria-label="Diğer işlemler"><%- include("partials/ikon", { ad: "daha", boyut: 20 }) %></button>
            <div class="acilir-menu acilir-menu-konumlu" id="profil-menusu" popover aria-label="Kullanıcı işlemleri">
              <% if (locals.engelledim) { %>
                <form method="post" action="/engel/<%= encodeURIComponent(profil.username) %>/kaldir"><input type="hidden" name="_csrf" value="<%= locals.csrf %>">
                  <button class="acilir-oge" type="submit"><%- include("partials/ikon", { ad: "yasak", boyut: 20 }) %><span class="acilir-ad">Engeli kaldır</span></button>
                </form>
              <% } else { %>
                <form method="post" action="/engel/<%= encodeURIComponent(profil.username) %>"><input type="hidden" name="_csrf" value="<%= locals.csrf %>">
                  <button class="acilir-oge acilir-oge-tehlikeli" type="submit"><%- include("partials/ikon", { ad: "yasak", boyut: 20 }) %><span class="acilir-ad">Engelle</span></button>
                </form>
              <% } %>
              <a class="acilir-oge acilir-oge-tehlikeli" href="/sikayet?kullanici=<%= encodeURIComponent(profil.username) %>" data-sikayet-ac data-kullanici="<%= profil.username %>" data-yazar="<%= profil.username %>"><%- include("partials/ikon", { ad: "bayrak", boyut: 20 }) %><span class="acilir-ad">Şikâyet et</span></a>
            </div>
          <% } else { %>
            <a class="buton buton-birincil" href="/mesajlar/<%= profil.username %>">Mesaj gönder</a>
          <% } %>
        <% } %>
      </div>
    </div>
    <%- include("partials/profil-efekt", { efekt: profil.profil_efekti, katman: "on" }) %>
  </div>

  <% if (profil.bio) { %><p class="bio"><%= profil.bio %></p><% } %>

  <section class="sutun">
    <div class="siralama">
      <a class="<%= sekme === 'konular' ? 'aktif' : '' %>" href="/profil/<%= profil.username %>"<%- sekme === 'konular' ? ' aria-current="page"' : '' %>>Konular</a>
      <a class="<%= sekme === 'yorumlar' ? 'aktif' : '' %>" href="/profil/<%= profil.username %>?sekme=yorumlar"<%- sekme === 'yorumlar' ? ' aria-current="page"' : '' %>>Yorumlar</a>
      <%# Puan geçmişi yalnızca kendi profilinde (kendisi); sekme "puan" zaten yalnızca kendisi için açılabilir %>
      <% if (kendisi) { %><a class="<%= sekme === 'puan' ? 'aktif' : '' %>" href="/profil/<%= profil.username %>?sekme=puan"<%- sekme === 'puan' ? ' aria-current="page"' : '' %>>Puan geçmişi</a><% } %>
    </div>
    <% if (sekme === "puan") { %>
      <%
        const sebepMetni = { konu: "Konu açtın", cevap: "Cevap yazdın", oy: "Mesajına oy verildi", gunluk: "Günlük ziyaret", seri: "7 günlük seri",
          cozum: "Cevabın çözüm seçildi", cozum_geri: "Çözüm işareti kalktı", rozet: "Rozet kazandın", rozet_geri: "Rozet geri alındı", duzeltme: "Puan düzeltmesi", silme: "Geri alınan puan", geri_yukleme: "Mesaj geri yüklendi",
          baslangic: "Önceki puanların", davet: "Davet" };
        // 'oy' satırı işarete göre ayrılır: artı = yazarın mesajına artı oy verildi (ya da eksi oyu geri alındı), eksi = eksi oy ya da geri alınan oy
        const sebepAd = (p) => p.sebep === "oy" ? (p.miktar > 0 ? "Mesajına artı oy verildi" : "Eksi oy ya da geri alınan oy") : (sebepMetni[p.sebep] || p.sebep);
      %>
      <% if (puanGecmisi.length === 0) { %><div class="kart bos">Henüz puan hareketi yok.</div><% } else { %>
        <div class="kart puan-gecmisi">
          <% for (const p of puanGecmisi) { %>
            <% const eski = p.sebep === "baslangic"; /* puan geçmişi tutulmadan önceki toplam: tarihi bilinmiyor, bağlantısı yok */ %>
            <% const baglanti = p.konu_id ? "/konu/" + p.konu_id : p.mesaj_id ? "/konu/" + p.mesaj_konu_id + "#mesaj-" + p.mesaj_id : null; %>
            <div class="puan-satir">
              <div class="puan-metin">
                <strong><%= sebepAd(p) %></strong>
                <% if (p.rozet) { %><span class="ikincil kucuk">“<%= p.rozet %>”</span><% } %>
                <% if (baglanti && !eski) { %><a class="baglanti kucuk" href="<%= baglanti %>">Görüntüle</a><% } %>
                <span class="ikincil kucuk"><%= eski ? "Sistem öncesi toplam" : zaman(p.created_at) %></span>
              </div>
              <span class="puan-miktar <%= p.miktar > 0 ? 'artti' : 'azaldi' %>"><%= p.miktar > 0 ? "+" : "−" %><%= Math.abs(p.miktar) %></span>
            </div>
          <% } %>
        </div>
        <%# Sayfalama: ?once=<son görünen log id> ile daha eski 100 hareket; JS gerekmez %>
        <div class="puan-sayfa">
          <% if (locals.once) { %><a class="baglanti" href="/profil/<%= profil.username %>?sekme=puan">← En yeni hareketler</a><% } else { %><span></span><% } %>
          <% if (locals.dahaEskiVar) { %><a class="baglanti" href="/profil/<%= profil.username %>?sekme=puan&once=<%= puanGecmisi[puanGecmisi.length - 1].id %>" rel="next">Daha eski →</a><% } %>
        </div>
        <% if (locals.dahaEskiVar) { %><p class="ikincil kucuk"><%= locals.once ? "Bu sayfada 100 hareket gösteriliyor." : "Son 100 hareket gösteriliyor." %></p><% } %>
      <% } %>
    <% } else if (sekme === "yorumlar") { %>
      <% if (yorumlar.length === 0) { %><div class="kart bos">Henüz yorum yazmamış.</div><% } %>
      <% for (const y of yorumlar) { %>
        <article class="kart profil-yorum">
          <div class="gonderi-meta">
            <a class="baglanti" href="/konu/<%= y.konu_id %>#mesaj-<%= y.id %>"><%= y.konu_baslik %></a>
            <span class="zaman">· <%= zaman(y.created_at) %></span>
          </div>
          <p class="metin"><%= y.content %></p>
        </article>
      <% } %>
    <% } else { %>
      <% if (konular.length === 0) { %><div class="kart bos">Henüz konu açmamış.</div><% } %>
      <% for (const konu of konular) { %>
        <%- include("partials/gonderi-karti", { konu }) %>
      <% } %>
    <% } %>
  </section>

  <section class="sutun">
    <h2 class="baslik-tipi" style="font-size: 22px; padding-top: 16px">İstatistikler</h2>
    <div class="istatistik">
      <div class="kart kutu">
        <div class="satir"><span class="buyuk-sayi"><%= toplam %> katkı</span><span class="ust-etiket">BU HAFTA</span></div>
        <div class="grafik" role="img" aria-label="Bu haftaki günlük katkı sayıları">
          <% for (const g of haftalik) { %>
            <div class="cubuk <%= g.bugun ? 'bugun' : '' %>" style="height: <%= Math.round(g.sayi / enCok * 100) %>%" title="<%= g.gun %>: <%= g.sayi %>"></div>
          <% } %>
        </div>
        <div class="gunler"><% for (const g of haftalik) { %><span class="<%= g.bugun ? 'bugun' : '' %>"><%= g.gun %></span><% } %></div>
      </div>
      <div class="kart kutu">
        <div class="rutbe-ust rutbe-<%= simdiki.renk %>">
          <span class="rutbe-kutu"><%- include("partials/ikon", { ad: simdiki.simge, boyut: 26 }) %></span>
          <div class="bosluk"><div class="ust-etiket">RÜTBE</div><div class="baslik-tipi rutbe-renk" style="font-size: 24px"><%= simdiki.name %></div></div>
          <div style="text-align: right"><div class="buyuk-sayi" style="font-size: 24px"><%= profil.points %></div><div class="ikincil" style="font-size: 12px">puan</div></div>
        </div>
        <div class="rutbe-ilerleme rutbe-<%= simdiki.renk %>">
          <div class="ilerleme" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= Math.round(oran * 100) %>" aria-label="Sonraki rütbeye ilerleme"><span style="width: <%= (oran * 100).toFixed(1) %>%"></span></div>
          <div class="rutbe-etiketleri">
            <span class="rutbe-renk"><%= simdiki.name %> · <%= simdiki.min_points %></span>
            <% if (sonraki) { %><span class="rutbe-<%= sonraki.renk %> rutbe-renk"><%= sonraki.name %> · <%= sonraki.min_points %></span><% } %>
          </div>
        </div>
        <% if (locals.yetkiliProfil) { %>
          <%# Admin/moderatör bütün ayrıcalıklardan muaf (src/rutbe.ts yetkiliMi): kilitli "açılacaklar" listesi yanıltıcı olur %>
          <div class="rutbe-sonraki"><div class="kucuk"><strong>Yetkili:</strong> bütün ayrıcalıklar açık</div></div>
        <% } %>
        <% if (sonraki) { %>
          <div class="rutbe-sonraki">
            <div class="kucuk"><strong><%= sonraki.name %></strong> rütbesine <strong><%= sonraki.min_points - profil.points %></strong> puan kaldı<%= acilacaklar.length && !locals.yetkiliProfil ? " · açılacaklar:" : "" %></div>
            <% if (acilacaklar.length && !locals.yetkiliProfil) { %>
              <ul class="rutbe-acilacak">
                <% for (const a of acilacaklar) { %><li<%- a.yakinda ? ' class="yakinda"' : "" %>><%- include("partials/ikon", { ad: "kilit", boyut: 14 }) %><%= a.etiket %><%= a.yakinda ? " · yakında" : "" %></li><% } %>
              </ul>
            <% } %>
          </div>
        <% } %>
        <div class="rutbe-alt">
          <%# "Puan geçmişi" burada yok: kendi profilinde sekme listesinde zaten duruyor (aynı hedef aynı sayfada iki kez olmasın).
              Boş span, "Bütün rütbeler" bağlantısını sağa yaslı tutar. %><span></span>
          <a class="baglanti" href="/rutbeler">Bütün rütbeler →</a>
        </div>
        <div class="sayilar">
          <div><strong><%= profil.konu_sayisi %></strong><span>konu</span></div>
          <div><strong><%= profil.mesaj_sayisi %></strong><span>mesaj</span></div>
          <div><strong><%= profil.alinan_oy %></strong><span>aldığı oy</span></div>
        </div>
        <div class="ust-etiket">ROZETLER</div>
        <div class="rozetler">
          <% if (rozetler.length === 0) { %><span class="ikincil kucuk">Henüz rozet yok.</span><% } %>
          <% for (const r of rozetler) { %><span class="rozet-cip"><%= r.name %></span><% } %>
        </div>
      </div>
    </div>
  </section>
</div>
<%# Kullanıcı şikâyeti penceresi: misafirde yok, "Şikâyet et" bağlantısı /sikayet üzerinden girişe götürür %>
<% if (locals.kullanici && !kendisi) { %><%- include("partials/sikayet-penceresi", { hedef_kullanici: profil.username, yazar: profil.username }) %><% } %>
<%- include("partials/son") %>
