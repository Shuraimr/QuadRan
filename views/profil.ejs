<%#
  Expected data:
  profil   { username, bio, avatar_url, banner_url, rol, created_at, points, rutbe,
             konu_sayisi, mesaj_sayisi, alinan_oy }
  rutbeler [ { id, name, min_points, renk, simge, ... } ]   sorted ascending by min_points (ranks table)
  simdiki  the profile's rank (one of rutbeler), sonraki  the next rank or undefined (top rank)
  acilacaklar [ { etiket } ]   privileges NEWLY unlocked at the next rank (shown in the locked box)
  puanGecmisi [ { id, miktar, sebep, created_at, konu_id, mesaj_konu_id, mesaj_id, rozet } ]   only on the "puan" tab (own profile)
  konular  [ post card data ]    same fields as partials/gonderi-karti
  rozetler [ { name } ]
  haftalik [ { gun: "Pzt", sayi: 2, bugun: false } ]   7 items, Monday to Sunday
  konum, web_sitesi  (inside profil, optional) shown in the meta row
  mesajAtabilir (bool), engelledim (bool)  for the visitor: whether "Send message" shows, whether the menu has Block or Unblock
  kendisi  bool   whether the logged-in person is looking at their own profile
  sabitKonu  post card data | null   topic pinned to the profile (optional)
  vitrinRozetleri [ { name, description, earned_at } ]   at most 3 badges selected in the showcase, in order (optional)
  etkinlikler [ { tur: konu|cevap|rozet|takip, zaman, konu_id, baslik, ek } ]   only on the "etkinlik" tab (public actions, at most 30)
  sekme    "konular" | "yorumlar" | "etkinlik" | "puan"   which tab is open (?sekme=yorumlar | puan; puan only on one's own profile)
  yorumlar [ { id, content, created_at, konu_id, konu_baslik } ]   only when the tab is "yorumlar" (replies, not first posts)

  Beklenen veriler:
  profil   { username, bio, avatar_url, banner_url, rol, created_at, points, rutbe,
             konu_sayisi, mesaj_sayisi, alinan_oy }
  rutbeler [ { id, name, min_points, renk, simge, ... } ]   min_points'e göre küçükten büyüğe (ranks tablosu)
  simdiki  profilin rütbesi (rutbeler'den biri), sonraki  bir sonraki rütbe ya da undefined (en üst rütbe)
  acilacaklar [ { etiket } ]   sonraki rütbede YENİ açılan ayrıcalıklar (kilitli kutuda gösterilir)
  puanGecmisi [ { id, miktar, sebep, created_at, konu_id, mesaj_konu_id, mesaj_id, rozet } ]   yalnızca sekme "puan" (kendi profili)
  konular  [ gönderi kartı verisi ]    partials/gonderi-karti ile aynı alanlar
  rozetler [ { name } ]
  haftalik [ { gun: "Pzt", sayi: 2, bugun: false } ]   7 eleman, Pazartesi'den Pazar'a
  konum, web_sitesi  (profil içinde, isteğe bağlı) meta satırında gösterilir
  mesajAtabilir (bool), engelledim (bool)  ziyaretçi için: "Mesaj gönder" görünsün mü, menüde Engelle mi Engeli kaldır mı
  kendisi  bool   giriş yapan kişi kendi profiline mi bakıyor
  sabitKonu  gönderi kartı verisi | null   profile sabitlenmiş konu (isteğe bağlı)
  vitrinRozetleri [ { name, description, earned_at } ]   vitrinde seçili en çok 3 rozet, sıraya göre (isteğe bağlı)
  etkinlikler [ { tur: konu|cevap|rozet|takip, zaman, konu_id, baslik, ek } ]   yalnızca sekme "etkinlik" (herkese açık eylemler, en çok 30)
  sekme    "konular" | "yorumlar" | "etkinlik" | "puan"   hangi sekme açık (?sekme=yorumlar | puan; puan yalnızca kendi profilinde)
  yorumlar [ { id, content, created_at, konu_id, konu_baslik } ]   yalnızca sekme "yorumlar" iken (ilk mesajlar değil, cevaplar)
%>
<%- include("partials/bas", { baslik: profil.username }) %>
<%- include("partials/ust-cubuk") %>
<%
  // If no tab is given (e.g. /onizleme/profil) Topics counts as open; an undefined variable must not crash the page
  // Sekme verilmediyse (örn. /onizleme/profil) Konular açık sayılır; tanımsız değişken sayfayı çökertmesin
  const sekme = ["yorumlar", "etkinlik", "puan"].includes(locals.sekme) ? locals.sekme : "konular";
  // Rank progress: fill ratio from the current rank's threshold toward the next one's (fully filled at the top rank)
  // Rütbe ilerlemesi: şimdiki rütbenin eşiğinden sonrakinin eşiğine doğru dolgu oranı (en üst rütbede tam dolu)
  const oran = sonraki ? Math.min(1, Math.max(0, (profil.points - simdiki.min_points) / (sonraki.min_points - simdiki.min_points))) : 1;
  const enCok = Math.max(1, ...haftalik.map(g => g.sayi));
  const toplam = haftalik.reduce((t, g) => t + g.sayi, 0);
  const vitrinRozet = locals.vitrinRozetleri || [];
  const vitrinDolu = !!locals.sabitKonu || vitrinRozet.length > 0;
%>
<div class="profil">
  <%# Top section: banner + identity. Profile color/effect/ornament come when the person is premium (the query returns NULL if not premium).
      Colors are validated as #rrggbb on the server. The back effect layer plays inside the banner, the front effect layer over the whole top section.
      Üst bölüm: banner + kimlik. Profil rengi/efekti/süsü kişi premium'dayken gelir (sorgu premium değilse NULL döndürür).
      Renkler sunucuda #rrggbb doğrulanır. Arka efekt katmanı banner'ın içinde, ön efekt katmanı bütün üst bölümün üstünde oynar. %>
  <div class="profil-ust" data-efekt="<%= profil.profil_efekti || '' %>"<%- Number(profil.profil_renk_gecis) ? " data-gecis" : "" %> style="<%= profil.profil_renk_ana ? '--pk-ana:' + profil.profil_renk_ana + ';' : '' %><%= profil.profil_renk_vurgu ? '--pk-vurgu:' + profil.profil_renk_vurgu : '' %>">
    <div class="banner" data-konum="<%= profil.banner_konum || 'orta' %>">
      <% if (profil.banner_url) { %><img src="<%= profil.banner_url %>" alt="" decoding="async"><% } else if (!profil.profil_renk_ana) { %><%- include("partials/kontur") %><% } %>
      <%- include("partials/profil-efekt", { efekt: profil.profil_efekti, katman: "arka" }) %>
    </div>
    <div class="kimlik">
      <%- include("partials/avatar", { ad: profil.username, url: profil.avatar_url, sus: profil.avatar_susu, sinif: "avatar-buyuk", oynat: true, bos: true }) %>
      <div class="kimlik-bilgi">
        <div class="satir"><h1><%= profil.username %></h1><% if (profil.rutbe) { %><%- include("partials/rutbe", { rutbeAd: profil.rutbe, rutbeId: profil.rutbe_id }) %><% } %><%- include("partials/unvan", { unvan: profil.unvan, premium: profil.premium }) %></div>
        <div class="satir ikincil kucuk kimlik-meta">
          <span class="meta-oge"><%- include("partials/ikon", { ad: "takvim", boyut: 16 }) %> <%= profil.rol %> · <%= new Date(profil.created_at).toLocaleDateString("tr-TR", { month: "long", year: "numeric" }) %> tarihinden beri üye</span>
          <%# Follow counts: two separate links, each goes to its list (src/rotalar/takip.ts). A missing count in preview data is treated as 0. · Takip sayıları: iki ayrı bağlantı, ilgili listeye gider (src/rotalar/takip.ts). Önizleme verisinde sayı yoksa 0 sayılır. %>
          <span class="meta-oge"><a class="baglanti" href="/profil/<%= encodeURIComponent(profil.username) %>/takipciler"><strong><%= profil.takipci_sayisi || 0 %></strong> takipçi</a> · <a class="baglanti" href="/profil/<%= encodeURIComponent(profil.username) %>/takip-edilenler"><strong><%= profil.takip_sayisi || 0 %></strong> takip</a></span>
          <% if (profil.konum) { %><span class="meta-oge"><%- include("partials/ikon", { ad: "konum", boyut: 16 }) %> <%= profil.konum %></span><% } %>
          <%# The address the user wrote: only http(s) is accepted (hesap.ts); do not pass trust to search engines (nofollow ugc) and open safely in a new tab (noopener) · Kullanıcının yazdığı adres: yalnızca http(s) kabul edilir (hesap.ts); arama motorlarına güven aktarma (nofollow ugc) ve yeni sekmede güvenli aç (noopener) %>
          <% if (profil.web_sitesi) { %><a class="meta-oge baglanti" href="<%= cikisAdresi(profil.web_sitesi) %>" data-dis-baglanti="<%= profil.web_sitesi %>" rel="nofollow ugc noopener noreferrer"><%- include("partials/ikon", { ad: "baglanti", boyut: 16 }) %> <%= profil.web_sitesi.replace(/^https?:\/\//i, "").replace(/\/$/, "") %></a><% } %>
        </div>
      </div>
      <div class="satir">
        <% if (locals.kullanici && ["admin", "moderator"].includes(locals.kullanici.rol)) { %>
          <a class="buton buton-cerceveli" href="/yonetim/uyeler/<%= profil.id %>">Yönetimde aç</a>
        <% } %>
        <% if (kendisi) { %>
          <a class="buton buton-tonal" href="/ayarlar">Profili düzenle</a>
          <a class="buton buton-cerceveli" href="/profil/<%= profil.username %>" data-paylas data-baslik="<%= profil.username %> · rubyyard">Paylaş</a>
        <% } else { %>
          <% if (locals.kullanici) { %>
            <%# On someone else's profile the primary action is "Takip et" (Follow); Send message is secondary. If there is a block between them the follow button is not drawn at all. · Başkasının profilinde birincil eylem "Takip et"; Mesaj gönder ikincil. Aradaki engel varsa takip düğmesi hiç çizilmez. %>
            <% if (!locals.aradaEngelVar) { %>
              <% if (locals.benTakipEdiyorMu) { %>
                <form method="post" action="/takip/<%= encodeURIComponent(profil.username) %>/birak"><input type="hidden" name="_csrf" value="<%= locals.csrf %>"><button class="buton buton-cerceveli" type="submit">Takibi bırak</button></form>
              <% } else { %>
                <form method="post" action="/takip/<%= encodeURIComponent(profil.username) %>"><input type="hidden" name="_csrf" value="<%= locals.csrf %>"><button class="buton buton-birincil" type="submit">Takip et</button></form>
              <% } %>
            <% } %>
            <% if (locals.mesajAtabilir) { %><a class="buton <%= locals.aradaEngelVar ? 'buton-birincil' : 'buton-tonal' %>" href="/mesajlar/<%= profil.username %>">Mesaj gönder</a><% } %>
            <%# Block and Report are in a single ⋮ menu (no separate "Report" button: the same action must not appear in two places) · Engelle ve Şikâyet et tek ⋮ menüsünde (ayrı bir "Şikâyet et" düğmesi yok: aynı eylem iki yerde durmasın) %>
            <button class="buton buton-cerceveli profil-menu-dugme" type="button" popovertarget="profil-menusu" data-menu-ac aria-label="Diğer işlemler"><%- include("partials/ikon", { ad: "daha", boyut: 20 }) %></button>
            <div class="acilir-menu acilir-menu-konumlu" id="profil-menusu" popover aria-label="Kullanıcı işlemleri">
              <% if (locals.engelledim) { %>
                <form method="post" action="/engel/<%= encodeURIComponent(profil.username) %>/kaldir"><input type="hidden" name="_csrf" value="<%= locals.csrf %>">
                  <button class="acilir-oge" type="submit"><%- include("partials/ikon", { ad: "yasak", boyut: 20 }) %><span class="acilir-ad">Engeli kaldır</span></button>
                </form>
              <% } else { %>
                <form method="post" action="/engel/<%= encodeURIComponent(profil.username) %>"><input type="hidden" name="_csrf" value="<%= locals.csrf %>">
                  <button class="acilir-oge acilir-oge-tehlikeli" type="submit"><%- include("partials/ikon", { ad: "yasak", boyut: 20 }) %><span class="acilir-ad">Engelle</span></button>
                </form>
              <% } %>
              <a class="acilir-oge acilir-oge-tehlikeli" href="/sikayet?kullanici=<%= encodeURIComponent(profil.username) %>" data-sikayet-ac data-kullanici="<%= profil.username %>" data-yazar="<%= profil.username %>"><%- include("partials/ikon", { ad: "bayrak", boyut: 20 }) %><span class="acilir-ad">Şikâyet et</span></a>
            </div>
          <% } else { %>
            <a class="buton buton-birincil" href="/giris?don=<%= encodeURIComponent('/profil/' + profil.username) %>">Takip et</a>
            <a class="buton buton-tonal" href="/mesajlar/<%= profil.username %>">Mesaj gönder</a>
          <% } %>
        <% } %>
      </div>
    </div>
    <%- include("partials/profil-efekt", { efekt: profil.profil_efekti, katman: "on" }) %>
  </div>

  <% if (profil.bio) { %><p class="bio"><%= profil.bio %></p><% } %>

  <%# Showcase: above the tabs. If empty it is not drawn at all on someone else's profile; on one's own profile a thin row leading to Settings appears. · Vitrin: sekmelerin üstünde. Boşsa başkasının profilinde hiç çizilmez; kişinin kendi profilinde Ayarlar'a götüren ince bir satır görünür. %>
  <% if (vitrinDolu) { %>
    <section class="sutun vitrin" aria-label="Vitrin">
      <% if (locals.sabitKonu) { %>
        <div class="vitrin-sabit">
          <div class="ust-etiket satir"><%- include("partials/ikon", { ad: "sabitle", boyut: 16 }) %> SABİTLENDİ</div>
          <%- include("partials/gonderi-karti", { konu: sabitKonu }) %>
        </div>
      <% } %>
      <% if (vitrinRozet.length) { %>
        <div class="vitrin-rozetler">
          <% for (const r of vitrinRozet) { %>
            <div class="kart vitrin-rozet">
              <span class="rozet-cip"><%= r.name %></span>
              <span class="kucuk"><%= r.description %></span>
              <span class="ikincil kucuk"><%= new Date(r.earned_at).toLocaleDateString("tr-TR", { day: "numeric", month: "long", year: "numeric" }) %> tarihinde kazanıldı</span>
            </div>
          <% } %>
        </div>
      <% } %>
    </section>
  <% } else if (kendisi) { %>
    <p class="ikincil kucuk vitrin-bos">Vitrinin boş. En sevdiğin rozetleri ve bir konunu öne çıkar. <a class="baglanti" href="/ayarlar#vitrin">Vitrini düzenle</a></p>
  <% } %>

  <section class="sutun">
    <div class="siralama">
      <a class="<%= sekme === 'konular' ? 'aktif' : '' %>" href="/profil/<%= profil.username %>"<%- sekme === 'konular' ? ' aria-current="page"' : '' %>>Konular</a>
      <a class="<%= sekme === 'yorumlar' ? 'aktif' : '' %>" href="/profil/<%= profil.username %>?sekme=yorumlar"<%- sekme === 'yorumlar' ? ' aria-current="page"' : '' %>>Yorumlar</a>
      <a class="<%= sekme === 'etkinlik' ? 'aktif' : '' %>" href="/profil/<%= profil.username %>?sekme=etkinlik"<%- sekme === 'etkinlik' ? ' aria-current="page"' : '' %>>Etkinlik</a>
      <%# Points history only on one's own profile; the "puan" tab can only be opened by the person themselves anyway · Puan geçmişi yalnızca kendi profilinde (kendisi); sekme "puan" zaten yalnızca kendisi için açılabilir %>
      <% if (kendisi) { %><a class="<%= sekme === 'puan' ? 'aktif' : '' %>" href="/profil/<%= profil.username %>?sekme=puan"<%- sekme === 'puan' ? ' aria-current="page"' : '' %>>Puan geçmişi</a><% } %>
    </div>
    <% if (sekme === "puan") { %>
      <%
        const sebepMetni = { konu: "Konu açtın", cevap: "Cevap yazdın", oy: "Mesajına oy verildi", gunluk: "Günlük ziyaret", seri: "7 günlük seri",
          cozum: "Cevabın çözüm seçildi", cozum_geri: "Çözüm işareti kalktı", rozet: "Rozet kazandın", rozet_geri: "Rozet geri alındı", duzeltme: "Puan düzeltmesi", silme: "Geri alınan puan", geri_yukleme: "Mesaj geri yüklendi",
          baslangic: "Önceki puanların", davet: "Davet" };
        // the 'oy' (vote) row is split by sign: plus = the author's post got an upvote (or a downvote was taken back), minus = a downvote or a vote that was taken back
        // 'oy' satırı işarete göre ayrılır: artı = yazarın mesajına artı oy verildi (ya da eksi oyu geri alındı), eksi = eksi oy ya da geri alınan oy
        const sebepAd = (p) => p.sebep === "oy" ? (p.miktar > 0 ? "Mesajına artı oy verildi" : "Eksi oy ya da geri alınan oy") : (sebepMetni[p.sebep] || p.sebep);
      %>
      <% if (puanGecmisi.length === 0) { %><div class="kart"><%- include("partials/bos-durum", { ikon: "yildiz", baslik: "Henüz puan hareketin yok", metin: "Konu açtıkça, cevap yazdıkça ve her gün giriş yaptıkça puan kazanırsın." }) %></div><% } else { %>
        <div class="kart puan-gecmisi">
          <% for (const p of puanGecmisi) { %>
            <% const eski = p.sebep === "baslangic"; /* puan geçmişi tutulmadan önceki toplam: tarihi bilinmiyor, bağlantısı yok */ %>
            <% const baglanti = p.konu_id ? "/konu/" + p.konu_id : p.mesaj_id ? "/konu/" + p.mesaj_konu_id + "#mesaj-" + p.mesaj_id : null; %>
            <div class="puan-satir">
              <div class="puan-metin">
                <strong><%= sebepAd(p) %></strong>
                <% if (p.rozet) { %><span class="ikincil kucuk">“<%= p.rozet %>”</span><% } %>
                <% if (baglanti && !eski) { %><a class="baglanti kucuk" href="<%= baglanti %>">Görüntüle</a><% } %>
                <span class="ikincil kucuk"><%= eski ? "Sistem öncesi toplam" : zaman(p.created_at) %></span>
              </div>
              <span class="puan-miktar <%= p.miktar > 0 ? 'artti' : 'azaldi' %>"><%= p.miktar > 0 ? "+" : "−" %><%= Math.abs(p.miktar) %></span>
            </div>
          <% } %>
        </div>
        <%# Pagination: ?once=<last seen log id> gives the 100 older entries; no JS needed · Sayfalama: ?once=<son görünen log id> ile daha eski 100 hareket; JS gerekmez %>
        <div class="puan-sayfa">
          <% if (locals.once) { %><a class="baglanti" href="/profil/<%= profil.username %>?sekme=puan">← En yeni hareketler</a><% } else { %><span></span><% } %>
          <% if (locals.dahaEskiVar) { %><a class="baglanti" href="/profil/<%= profil.username %>?sekme=puan&once=<%= puanGecmisi[puanGecmisi.length - 1].id %>" rel="next">Daha eski →</a><% } %>
        </div>
        <% if (locals.dahaEskiVar) { %><p class="ikincil kucuk"><%= locals.once ? "Bu sayfada 100 hareket gösteriliyor." : "Son 100 hareket gösteriliyor." %></p><% } %>
      <% } %>
    <% } else if (sekme === "etkinlik") { %>
      <%
        // An icon + sentence for each type; user text (title, badge name, username) is printed escaped
        // Her tür için ikon + cümle; kullanıcı metni (başlık, rozet adı, kullanıcı adı) kaçışlı basılır
        const etkinlikIkon = { konu: "kalem", cevap: "yorum", rozet: "kupa", takip: "kisi" };
        const etkinlikler_ = locals.etkinlikler || [];
      %>
      <% if (etkinlikler_.length === 0) { %><div class="kart"><%- include("partials/bos-durum", { ikon: "kutu", baslik: kendisi ? "Henüz etkinliğin yok" : "Henüz etkinlik yok" }) %></div><% } else { %>
        <div class="kart puan-gecmisi">
          <% for (const e of etkinlikler_) { %>
            <div class="puan-satir etkinlik-satir">
              <span class="ikincil etkinlik-ikon"><%- include("partials/ikon", { ad: etkinlikIkon[e.tur], boyut: 20 }) %></span>
              <div class="puan-metin">
                <% if (e.tur === "konu") { %><span>Konu açtı: <a class="baglanti" href="/konu/<%= e.konu_id %>"><%= e.baslik %></a></span>
                <% } else if (e.tur === "cevap") { %><span><a class="baglanti" href="/konu/<%= e.konu_id %>#mesaj-<%= e.ek_id %>"><%= e.baslik %></a> konusuna cevap yazdı</span><span class="ikincil kucuk etkinlik-ek"><%= e.ek %></span>
                <% } else if (e.tur === "rozet") { %><span>“<%= e.baslik %>” rozetini kazandı</span>
                <% } else { %><span><a class="baglanti" href="/profil/<%= encodeURIComponent(e.baslik) %>"><%= e.baslik %></a> kişisini takip etmeye başladı</span><% } %>
              </div>
              <span class="ikincil kucuk etkinlik-zaman"><%= zaman(e.zaman) %></span>
            </div>
          <% } %>
        </div>
      <% } %>
    <% } else if (sekme === "yorumlar") { %>
      <% if (yorumlar.length === 0) { %><div class="kart"><%- include("partials/bos-durum", { ikon: "yorum", baslik: kendisi ? "Henüz yorum yazmadın" : "Henüz yorum yazmamış" }) %></div><% } %>
      <% for (const y of yorumlar) { %>
        <article class="kart profil-yorum">
          <div class="gonderi-meta">
            <a class="baglanti" href="/konu/<%= y.konu_id %>#mesaj-<%= y.id %>"><%= y.konu_baslik %></a>
            <%# No time separator: when the row wrapped a lone "·" was left at the start; the gap between them is enough · Zaman ayraçsız: satır kırılınca başta tek "·" kalıyordu; aradaki boşluk (gap) yeterli %><span class="zaman"><%= zaman(y.created_at) %></span>
          </div>
          <p class="metin"><%= y.content %></p>
        </article>
      <% } %>
    <% } else { %>
      <% if (konular.length === 0) { %><div class="kart"><%- include("partials/bos-durum", { ikon: "kalem", baslik: kendisi ? "Henüz konu açmadın" : "Henüz konu açmamış", eylem: kendisi ? { href: "/konu/yeni", etiket: "Konu aç" } : null }) %></div><% } %>
      <% for (const konu of konular) { %>
        <%- include("partials/gonderi-karti", { konu }) %>
      <% } %>
    <% } %>
  </section>

  <section class="sutun">
    <h2 class="baslik-tipi" style="font-size: 22px; padding-top: 16px">İstatistikler</h2>
    <div class="istatistik">
      <div class="kart kutu">
        <div class="satir"><span class="buyuk-sayi"><%= toplam %> katkı</span><span class="ust-etiket">BU HAFTA</span></div>
        <div class="grafik" role="img" aria-label="Bu haftaki günlük katkı sayıları">
          <% for (const g of haftalik) { %>
            <div class="cubuk <%= g.bugun ? 'bugun' : '' %>" style="height: <%= Math.round(g.sayi / enCok * 100) %>%" title="<%= g.gun %>: <%= g.sayi %>"></div>
          <% } %>
        </div>
        <div class="gunler"><% for (const g of haftalik) { %><span class="<%= g.bugun ? 'bugun' : '' %>"><%= g.gun %></span><% } %></div>
      </div>
      <div class="kart kutu">
        <div class="rutbe-ust rutbe-<%= simdiki.renk %>">
          <span class="rutbe-kutu"><%- include("partials/ikon", { ad: simdiki.simge, boyut: 26 }) %></span>
          <div class="bosluk"><div class="ust-etiket">RÜTBE</div><div class="baslik-tipi rutbe-renk" style="font-size: 24px"><%= simdiki.name %></div></div>
          <div style="text-align: right"><div class="buyuk-sayi" style="font-size: 24px"><%= profil.points %></div><div class="ikincil" style="font-size: 12px">puan</div></div>
        </div>
        <div class="rutbe-ilerleme rutbe-<%= simdiki.renk %>">
          <div class="ilerleme" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= Math.round(oran * 100) %>" aria-label="Sonraki rütbeye ilerleme"><span style="width: <%= (oran * 100).toFixed(1) %>%"></span></div>
          <div class="rutbe-etiketleri">
            <span class="rutbe-renk"><%= simdiki.name %> · <%= simdiki.min_points %></span>
            <% if (sonraki) { %><span class="rutbe-<%= sonraki.renk %> rutbe-renk"><%= sonraki.name %> · <%= sonraki.min_points %></span><% } %>
          </div>
        </div>
        <% if (locals.yetkiliProfil) { %>
          <%# Admin/moderator are exempt from all privileges (src/rutbe.ts yetkiliMi): a locked "to be unlocked" list would be misleading · Admin/moderatör bütün ayrıcalıklardan muaf (src/rutbe.ts yetkiliMi): kilitli "açılacaklar" listesi yanıltıcı olur %>
          <div class="rutbe-sonraki"><div class="kucuk"><strong>Yetkili:</strong> bütün ayrıcalıklar açık</div></div>
        <% } %>
        <% if (sonraki) { %>
          <div class="rutbe-sonraki">
            <div class="kucuk"><strong><%= sonraki.name %></strong> rütbesine <strong><%= sonraki.min_points - profil.points %></strong> puan kaldı<%= acilacaklar.length && !locals.yetkiliProfil ? " · açılacaklar:" : "" %></div>
            <% if (acilacaklar.length && !locals.yetkiliProfil) { %>
              <ul class="rutbe-acilacak">
                <% for (const a of acilacaklar) { %><li<%- a.yakinda ? ' class="yakinda"' : "" %>><%- include("partials/ikon", { ad: "kilit", boyut: 14 }) %><%= a.etiket %><%= a.yakinda ? " · yakında" : "" %></li><% } %>
              </ul>
            <% } %>
          </div>
        <% } %>
        <div class="rutbe-alt">
          <%# No "Points history" here: on one's own profile it is already in the tab list (the same target must not appear twice on one page).
              The empty span keeps the "All ranks" link pushed to the right.
              "Puan geçmişi" burada yok: kendi profilinde sekme listesinde zaten duruyor (aynı hedef aynı sayfada iki kez olmasın).
              Boş span, "Bütün rütbeler" bağlantısını sağa yaslı tutar. %><span></span>
          <a class="baglanti" href="/rutbeler">Bütün rütbeler →</a>
        </div>
        <div class="sayilar">
          <div><strong><%= profil.konu_sayisi %></strong><span>konu</span></div>
          <div><strong><%= profil.mesaj_sayisi %></strong><span>mesaj</span></div>
          <div><strong><%= profil.alinan_oy %></strong><span>aldığı oy</span></div>
        </div>
        <div class="ust-etiket">ROZETLER</div>
        <div class="rozetler">
          <% if (rozetler.length === 0) { %><span class="ikincil kucuk">Henüz rozet yok.</span><% } %>
          <% for (const r of rozetler) { %><span class="rozet-cip"><%= r.name %></span><% } %>
        </div>
      </div>
    </div>
  </section>
</div>
<%# User report window: absent for guests, the "Report" link leads to login via /sikayet · Kullanıcı şikâyeti penceresi: misafirde yok, "Şikâyet et" bağlantısı /sikayet üzerinden girişe götürür %>
<% if (locals.kullanici && !kendisi) { %><%- include("partials/sikayet-penceresi", { hedef_kullanici: profil.username, yazar: profil.username }) %><% } %>
<%- include("partials/son") %>
