<%#
  /premium (placeholder). u: the person's own card data (profil-karti.ejs), premium (bool).
  No advertising language; it only says what it is and how it is currently granted.
%>
<%#
  /premium (yer tutucu). u: kişinin kendi kartı verisi (profil-karti.ejs), premium (bool).
  Reklam dili yok; yalnızca ne olduğunu ve şimdilik nasıl verildiğini söyler.
%>
<%- include("partials/bas", { baslik: "Premium" }) %>
<%- include("partials/ust-cubuk") %>
<main class="premium-sayfa">
  <%- include("partials/geri-baslik", { href: "/ayarlar", etiket: "Ayarlar" }) %>
  <h1>Premium</h1>
  <%- include("partials/profil-karti", { u }) %>
  <p class="ikincil">Premium üyeler profil efekti, avatar süsü, serbest profil rengi ile hareketli avatar ve banner kullanabilir. Yukarıdaki kart şu anki profil kartın.</p>
  <p class="ikincil">Premium şu an yönetici tarafından veriliyor. <%= premium ? "Hesabında premium açık" + (u.premium_bitis && new Date(u.premium_bitis).getFullYear() < 3000 ? ": " + new Date(u.premium_bitis).toLocaleDateString("tr-TR") + " tarihine kadar." : " (süresiz).") : "Hesabında premium kapalı." %></p>
  <a class="buton buton-tonal" href="/ayarlar#profil-gorunumu">Profil görünümü ayarları</a>
</main>
<%- include("partials/son") %>
