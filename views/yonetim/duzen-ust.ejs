<%#
  Yönetim paneli ortak düzeni (üst yarı). Her sayfa: duzen-ust ... içerik ... duzen-alt
  Beklenen veriler: baslik (üst çubuktaki sayfa başlığı), aktif (kenar menüdeki öğe kimliği: "bakis" | "sikayetler" | "yaptirimlar" | "filtre" |
  "forum" | "sohbet" | "uyeler" | "puan" | "duyurular" | "kayit-erisim" | "islem-kaydi"), locals.menu (yonetim.ts, role göre süzülmüş gruplar),
  locals.kullanici. geri: { ad, href } verilirse başlığın üstünde "← ad" bağlantısı çıkar (üye kartı).
  Düzen: ≥1180px solda 248px sabit kenar çubuğu; 801-1179px 72px simge şeridi (ipucu title ile); ≤800px menü üstte yatay kaydırmalı şerit.
%>
<%- include("../partials/bas", { sade: true, baslik: "Yönetim · " + locals.baslik }) %>
<div class="yn">
  <aside class="yn-yan">
    <a class="yn-marka" href="/yonetim" title="Yönetim"><span class="yn-marka-isaret">Q</span><span class="yn-marka-ad">Yönetim</span></a>
    <nav class="yn-nav" aria-label="Yönetim menüsü">
      <% for (const g of locals.menu || []) { %>
        <div class="yn-grup">
          <% if (g.ad) { %><p class="yn-grup-ad"><%= g.ad %></p><% } %>
          <% for (const o of g.ogeler) { %>
            <% if (o.yakinda) { %>
              <span class="yn-oge yakinda" title="<%= o.ad %> (yakında)"><%- include("../partials/ikon", { ad: o.ikon, boyut: 18 }) %><span class="yn-oge-ad"><%= o.ad %></span><small class="yn-yakinda">yakında</small></span>
            <% } else { %>
              <a class="yn-oge<%= locals.aktif === o.id ? ' aktif' : '' %>" href="<%= o.href %>" title="<%= o.ad %>"<%- locals.aktif === o.id ? ' aria-current="page"' : '' %>>
                <%- include("../partials/ikon", { ad: o.ikon, boyut: 18 }) %><span class="yn-oge-ad"><%= o.ad %></span>
                <% if (o.sayi) { %><b class="yn-sayi" aria-label="<%= o.sayi %> bekleyen"><%= o.sayi %></b><% } %>
              </a>
            <% } %>
          <% } %>
        </div>
      <% } %>
    </nav>
    <a class="yn-oge yn-site" href="/" title="Siteye dön"><%- include("../partials/ikon", { ad: "ev", boyut: 18 }) %><span class="yn-oge-ad">Siteye dön</span></a>
  </aside>
  <div class="yn-ana">
    <header class="yn-ust">
      <div class="yn-ust-baslik">
        <% if (locals.geri) { %><a class="yn-geri" href="<%= geri.href %>">← <%= geri.ad %></a><% } %>
        <h1 class="yn-baslik"><%= locals.baslik %></h1>
      </div>
      <form class="yn-ara" method="get" action="/yonetim/ara" role="search">
        <%- include("../partials/ikon", { ad: "ara", boyut: 18 }) %>
        <input type="search" name="q" data-yn-ara placeholder="Üye, konu ya da #şikâyet ara" aria-label="Panelde ara" aria-keyshortcuts="Control+K" value="<%= locals.aramaMetni || '' %>">
        <kbd class="kisayol">Ctrl K</kbd>
      </form>
      <a class="avatar yn-ust-avatar" href="/profil/<%= kullanici.username %>" title="<%= kullanici.username %> (<%= kullanici.rol %>)"><%= kullanici.username[0] %></a>
    </header>
    <main class="yn-icerik">
