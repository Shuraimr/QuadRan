<%#
  Son 30 günün çubuk grafiği (kütüphanesiz: her gün bir <span>, yüksekliği oransal).
  Beklenen: baslik, seri { veri: [{gun, n}], toplam, en }
%>
<section class="kart yn-kart" aria-label="<%= baslik %>">
  <div class="yn-kart-ust"><h3><%= baslik %></h3><strong><%= seri.toplam %></strong></div>
  <div class="yn-grafik" role="img" aria-label="<%= baslik %>: son 30 günde toplam <%= seri.toplam %>">
    <% for (const g of seri.veri) { %><span class="yn-sutun<%= g.n === 0 ? ' sifir' : '' %>" style="height: <%= Math.round(g.n / seri.en * 100) %>%" title="<%= g.gun %>: <%= g.n %>"></span><% } %>
  </div>
  <div class="yn-grafik-alt"><span><%= seri.veri[0].gun.slice(5) %></span><span>son 30 gün</span><span><%= seri.veri[seri.veri.length - 1].gun.slice(5) %></span></div>
</section>
