<%#
  Rütbeler: rutbeler [{ id, name, min_points, renk, simge, oda_ac, baglanti, gorsel, video, imza, gunluk_oy (null = sınırsız), kullanici_sayisi }],
  renkler, renkAdlari, simgeler, simgeAdlari, ayricaliklar [{ anahtar, ad }]
  Formlar: POST /yonetim/puan/rutbeler (yeni rütbe: name, min_points, renk, simge)
           POST /yonetim/puan/rutbeler/kaydet (bütün tablo; alanlar <ad>_<rütbe no>: name, min_points, renk, simge, oda_ac, baglanti, gorsel, video, imza, gunluk_oy)
           POST /yonetim/puan/rutbeler/:id/sil
%>
<%- include("duzen-ust", { baslik: "Puan ve ödüller", aktif: "puan" }) %>
<%- include("puan-sekmeler", { sekme: "rutbeler" }) %>

<form class="kart yn-kart yn-form yn-satir yn-genis" method="post" action="/yonetim/puan/rutbeler"><%- include("csrf") %>
  <label class="yn-etiketli">Rütbe ekle<input class="yn-girdi" name="name" minlength="2" maxlength="32" placeholder="Rütbe adı" required></label>
  <label class="yn-etiketli yn-dar">En az puan<input class="yn-girdi" type="number" name="min_points" min="1" required></label>
  <label class="yn-etiketli">Renk<select class="yn-girdi" name="renk"><% for (const r of renkler) { %><option value="<%= r %>"><%= renkAdlari[r] %></option><% } %></select></label>
  <label class="yn-etiketli">Simge<select class="yn-girdi" name="simge"><% for (const s of simgeler) { %><option value="<%= s %>"><%= simgeAdlari[s] %></option><% } %></select></label>
  <button class="buton buton-birincil">Rütbe ekle</button>
</form>
<p class="ikincil kucuk">Yeni rütbenin ayrıcalıkları bir alttaki rütbeden kopyalanır; sonra tablodan değiştirilir. 0 puanlık taban rütbe silinemez ve eşiği değişmez.</p>

<form class="kart yn-tablo-kutu" id="rutbe-form" method="post" action="/yonetim/puan/rutbeler/kaydet"><%- include("csrf") %>
  <table class="yn-tablo yn-rutbe-tablo">
    <thead><tr>
      <th>Rütbe</th><th>Eşik</th>
      <% for (const a of ayricaliklar) { %><th><%= a.anahtar === "oda_ac" ? "Oda aç" : a.anahtar === "baglanti" ? "Bağlantı" : a.anahtar === "gorsel" ? "Görsel" : a.anahtar === "video" ? "Video" : "İmza" %></th><% } %>
      <th>Günlük oy</th><th>Aylık yakut</th><th>Kullanıcı</th><th></th>
    </tr></thead>
    <tbody>
      <% for (const r of rutbeler) { %>
        <tr>
          <td data-etiket="Rütbe">
            <div class="yn-rutbe-hucre">
              <div class="yn-rutbe-onizleme"><%- include("../partials/rutbe", { rutbeAd: r.name, rutbeId: r.id }) %></div>
              <input class="yn-girdi" name="name_<%= r.id %>" value="<%= r.name %>" minlength="2" maxlength="32" required aria-label="<%= r.name %> rütbe adı">
              <select class="yn-girdi" name="renk_<%= r.id %>" aria-label="<%= r.name %> rengi"><% for (const k of renkler) { %><option value="<%= k %>"<%= r.renk === k ? " selected" : "" %>><%= renkAdlari[k] %></option><% } %></select>
              <select class="yn-girdi" name="simge_<%= r.id %>" aria-label="<%= r.name %> simgesi"><% for (const k of simgeler) { %><option value="<%= k %>"<%= r.simge === k ? " selected" : "" %>><%= simgeAdlari[k] %></option><% } %></select>
            </div>
          </td>
          <td data-etiket="Eşik"><input class="yn-girdi yn-sayi" type="number" name="min_points_<%= r.id %>" value="<%= r.min_points %>" min="0" required<%= r.min_points === 0 ? " readonly" : "" %> aria-label="<%= r.name %> en az puan"></td>
          <% for (const a of ayricaliklar) { %>
            <td data-etiket="<%= a.ad %>"><input type="checkbox" name="<%= a.anahtar %>_<%= r.id %>" value="1"<%= r[a.anahtar] ? " checked" : "" %> aria-label="<%= r.name %>: <%= a.ad %>"></td>
          <% } %>
          <td data-etiket="Günlük oy"><input class="yn-girdi yn-sayi" type="number" name="gunluk_oy_<%= r.id %>" value="<%= r.gunluk_oy === null ? '' : r.gunluk_oy %>" min="0" placeholder="sınırsız" aria-label="<%= r.name %> günlük oy sınırı"></td>
          <td data-etiket="Aylık yakut"><input class="yn-girdi yn-sayi" type="number" name="aylik_yakut_<%= r.id %>" value="<%= r.aylik_yakut %>" min="0" max="100000" required aria-label="<%= r.name %> aylık yakut harçlığı"></td>
          <td data-etiket="Kullanıcı"><span class="ikincil"><%= r.kullanici_sayisi %></span></td>
          <td><% if (r.min_points !== 0) { %><button class="buton buton-tehlikeli" type="submit" form="rutbe-sil-<%= r.id %>">Sil</button><% } %></td>
        </tr>
      <% } %>
    </tbody>
  </table>
  <div class="yn-rutbe-alt">
    <p class="ikincil kucuk">Günlük oy boşsa sınırsızdır. Yönetici ve moderatörler bütün ayrıcalık denetimlerinden muaftır. Görsel ve video ayrıcalıkları yükleme özelliği geldiğinde kullanılacak (şimdilik yalnızca saklanır).</p>
    <button class="buton buton-birincil">Kaydet</button>
  </div>
</form>
<% for (const r of rutbeler) { if (r.min_points !== 0) { %>
  <form id="rutbe-sil-<%= r.id %>" data-onay="<%= r.name %> rütbesi silinsin mi?" method="post" action="/yonetim/puan/rutbeler/<%= r.id %>/sil"><%- include("csrf") %></form>
<% } } %>
<%- include("duzen-alt") %>
