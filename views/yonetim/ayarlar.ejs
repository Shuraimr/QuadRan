<%# Site ayarları (admin): a { kayitAcik, duyuru, duyuruTur, yasakli[] }, yasakliMetin %>
<%- include("duzen-ust", { baslik: "Site ayarları", aktif: "ayarlar" }) %>
<form class="kart yn-kart yn-form" method="post" action="/yonetim/ayarlar"><%- include("csrf") %>
  <h3>Kayıt</h3>
  <label class="onay"><input type="checkbox" name="kayit_acik" value="1"<%= a.kayitAcik ? " checked" : "" %>> Yeni kayıtlara açık</label>
  <p class="ikincil kucuk">Kapalıyken /kayit sayfası “kayıtlar kapalı” der ve doğrudan gönderilen formlar da reddedilir.</p>

  <h3>Duyuru şeridi</h3>
  <label class="yn-etiketli">Metin (boş bırakırsan şerit görünmez)<textarea class="yn-girdi yn-alan" name="duyuru" rows="2" maxlength="500"><%= a.duyuru %></textarea></label>
  <label class="yn-etiketli">Tür<select class="yn-girdi" name="duyuru_tur"><option value="info"<%= a.duyuruTur === "info" ? " selected" : "" %>>Bilgi</option><option value="uyari"<%= a.duyuruTur === "uyari" ? " selected" : "" %>>Uyarı</option></select></label>
  <p class="ikincil kucuk">Menülü bütün sayfaların üstünde görünür; her kullanıcı kendi oturumunda kapatabilir, metin değişince yeniden çıkar.</p>

  <h3>Yasaklı ifadeler</h3>
  <label class="yn-etiketli">Satır başına bir ifade (konu başlığı/içeriği, cevap, sohbet ve özel mesajlarda reddedilir)
    <textarea class="yn-girdi yn-alan" name="yasakli_kelimeler" rows="6"><%= yasakliMetin %></textarea></label>
  <p class="ikincil kucuk">Büyük/küçük harf fark etmez (Türkçe kurallarıyla: I/ı, İ/i). İfade metnin içinde geçiyorsa eşleşir, kelime kökünü de yakalar.</p>
  <button class="buton buton-birincil">Kaydet</button>
</form>
<%- include("duzen-alt") %>
