<%#
  Forum (Konular, Mesajlar) ve Sohbet listesi: /yonetim/forum, /yonetim/forum/mesajlar, /yonetim/sohbet
  tur, satirlar, sf, kategoriler, qs { q, yazar, durum, kategori }, yol, filtreli
  Toplu işlem formu: POST /yonetim/toplu  alanlar: tur, eylem, id (çoklu), kategori, sebep (silmede zorunlu; onay adımı gelir)
%>
<%- include("duzen-ust", { baslik: baslik, aktif: aktif }) %>
<% if (tur === "sohbet") { %>
  <div class="yn-sekmeler siralama"><a class="aktif" href="/yonetim/sohbet">Genel sohbet</a><a href="/yonetim/sohbet/odalar">Odalar</a></div>
<% } else { %><%- include("forum-sekmeler", { sekme: tur }) %><% } %>
<form class="yn-filtre kart" method="get" action="<%= yol %>">
  <input class="yn-girdi" type="search" name="q" value="<%= qs.q %>" placeholder="<%= tur === 'konu' ? 'Başlıkta ara' : 'Metinde ara' %>" aria-label="Ara">
  <input class="yn-girdi" name="yazar" value="<%= qs.yazar %>" placeholder="Yazar" aria-label="Yazar">
  <% if (tur !== "sohbet") { %>
    <select class="yn-girdi" name="kategori" aria-label="Kategori"><option value="">Tüm kategoriler</option>
      <% for (const c of kategoriler) { %><option value="<%= c.id %>"<%= String(qs.kategori) === String(c.id) ? " selected" : "" %>><%= c.name %></option><% } %></select>
  <% } %>
  <select class="yn-girdi" name="durum" aria-label="Durum"><% for (const [d, e] of [["aktif","Yayında"],["silinmis","Silinmiş"],["hepsi","Hepsi"]]) { %><option value="<%= d %>"<%= qs.durum === d ? " selected" : "" %>><%= e %></option><% } %></select>
  <button class="buton buton-tonal yn-suz-dugme">Süz</button>
</form>

<form method="post" action="/yonetim/toplu" id="toplu-form"><%- include("csrf") %><input type="hidden" name="tur" value="<%= tur %>">
  <div class="yn-toplu kart" data-alt-cubuk>
    <label class="onay"><input type="checkbox" data-hepsini-sec aria-label="Hepsini seç"> Hepsini seç</label>
    <select class="yn-girdi" name="eylem" aria-label="Toplu işlem" required>
      <option value="">Seçilenlere uygula…</option>
      <option value="sil">Sil</option><option value="geri_al">Geri al (silinmişi geri getir)</option>
      <% if (tur === "konu") { %>
        <option value="sabitle">Sabitle</option><option value="sabit_kaldir">Sabiti kaldır</option>
        <option value="kilitle">Kilitle</option><option value="kilit_ac">Kilidi aç</option>
        <option value="tasi">Kategoriye taşı →</option>
      <% } %>
    </select>
    <% if (tur === "konu") { %>
      <select class="yn-girdi" name="kategori" aria-label="Taşınacak kategori"><option value="">Kategori…</option>
        <% for (const c of kategoriler) { %><option value="<%= c.id %>"><%= c.name %></option><% } %></select>
    <% } %>
    <input class="yn-girdi" name="sebep" maxlength="200" placeholder="Sebep (silmede zorunlu)" aria-label="Sebep">
    <button class="buton buton-birincil">Uygula</button>
  </div>

  <div class="kart yn-tablo-kutu">
    <table class="yn-tablo">
      <thead><tr><th></th><th>#</th>
        <% if (tur === "konu") { %><th>Başlık</th><th>Kategori</th><th>Yazar</th><th>Mesaj</th><th>Durum</th><th>Tarih</th>
        <% } else if (tur === "mesaj") { %><th>Mesaj</th><th>Konu</th><th>Yazar</th><th>Durum</th><th>Tarih</th>
        <% } else { %><th>Mesaj</th><th>Yazar</th><th>Durum</th><th>Tarih</th><% } %>
      </tr></thead>
      <tbody>
      <% if (!satirlar.length) { %><tr><td colspan="9" class="bos"><%- include("bos", { filtreli: filtreli, bosMetin: "Henüz kayıt yok", sifirla: yol }) %></td></tr><% } %>
      <% for (const s of satirlar) { %>
        <tr>
          <td><input type="checkbox" name="id" value="<%= s.id %>" aria-label="<%= s.id %> numaralıyı seç"></td>
          <td data-etiket="#"><%= s.id %></td>
          <% if (tur === "konu") { %>
            <td data-etiket="Başlık" class="yn-kisa"><a href="/konu/<%= s.id %>"><%= s.title %></a></td>
            <td data-etiket="Kategori"><%= s.kategori %></td>
            <td data-etiket="Yazar"><a href="/yonetim/uyeler/<%= s.yazar_id %>"><%= s.yazar %></a></td>
            <td data-etiket="Mesaj"><%= s.mesaj_sayisi %></td>
            <td data-etiket="Durum">
              <% if (s.deleted_at) { %><span class="yn-etiket tehlike">Silinmiş</span><% } %>
              <% if (s.pinned_at) { %><span class="yn-etiket">Sabit</span><% } %>
              <% if (s.locked_at) { %><span class="yn-etiket">Kilitli</span><% } %>
              <% if (!s.deleted_at && !s.pinned_at && !s.locked_at) { %><span class="ikincil">Yayında</span><% } %>
            </td>
          <% } else if (tur === "mesaj") { %>
            <td data-etiket="Mesaj" class="yn-kisa"><a href="/konu/<%= s.topic_id %>#mesaj-<%= s.id %>"><%= s.content %></a></td>
            <td data-etiket="Konu" class="yn-kisa"><%= s.konu_baslik %></td>
            <td data-etiket="Yazar"><a href="/yonetim/uyeler/<%= s.yazar_id %>"><%= s.yazar %></a></td>
            <td data-etiket="Durum"><% if (s.deleted_at) { %><span class="yn-etiket tehlike">Silinmiş</span><% } else { %><span class="ikincil">Yayında</span><% } %><% if (s.ilk_mi) { %> <span class="yn-etiket">Konu metni</span><% } %></td>
          <% } else { %>
            <td data-etiket="Mesaj" class="yn-kisa"><%= s.content %></td>
            <td data-etiket="Yazar"><a href="/yonetim/uyeler/<%= s.yazar_id %>"><%= s.yazar %></a></td>
            <td data-etiket="Durum"><% if (s.deleted_at) { %><span class="yn-etiket tehlike">Silinmiş</span><% } else { %><span class="ikincil">Yayında</span><% } %></td>
          <% } %>
          <td data-etiket="Tarih"><%= zaman(s.created_at) %></td>
        </tr>
      <% } %>
      </tbody>
    </table>
  </div>
</form>
<%- include("sayfalama") %>
<%- include("duzen-alt") %>
