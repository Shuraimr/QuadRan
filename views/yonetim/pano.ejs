<%#
  Pano: /yonetim
  t { kullanici, konu, mesaj, sohbet, ozel, sikayet, banli }, cevrimici [{username}], kategoriler [{id,name,konu,mesaj}],
  bekleyenler [{id, hedef_tur, sebep, created_at, bildiren, hedef}], sonIslemler (yalnızca admin), grafikler { yeniKullanici, yeniKonu, yeniMesaj }
%>
<%- include("duzen-ust", { baslik: "Pano", aktif: "pano" }) %>
<section class="yn-sayaclar">
  <% for (const [ad, deger, href, vurgu] of [
    ["Kullanıcı", t.kullanici, kullanici.rol === "admin" ? "/yonetim/kullanicilar" : null], ["Konu", t.konu, "/yonetim/icerik?tur=konu"],
    ["Mesaj", t.mesaj, "/yonetim/icerik?tur=mesaj"], ["Sohbet mesajı", t.sohbet, "/yonetim/icerik?tur=sohbet"],
    ["Özel mesaj", t.ozel, null], ["Bekleyen şikâyet", t.sikayet, "/yonetim/sikayetler", t.sikayet > 0],
    ["Uzaklaştırılmış", t.banli, kullanici.rol === "admin" ? "/yonetim/kullanicilar?banli=evet" : null], ["Şu an çevrimiçi", cevrimici.length, null]
  ]) { %>
    <% const etiket = href ? "a" : "div"; %>
    <<%= etiket %> class="kart yn-sayac<%= vurgu ? ' vurgulu' : '' %>"<% if (href) { %> href="<%= href %>"<% } %>><strong><%= deger %></strong><span><%= ad %></span></<%= etiket %>>
  <% } %>
</section>

<section class="yn-izgara-3">
  <%- include("grafik", { baslik: "Yeni kullanıcı", seri: grafikler.yeniKullanici }) %>
  <%- include("grafik", { baslik: "Yeni konu", seri: grafikler.yeniKonu }) %>
  <%- include("grafik", { baslik: "Yeni mesaj", seri: grafikler.yeniMesaj }) %>
</section>

<section class="yn-izgara-2">
  <div class="kart yn-kart">
    <div class="yn-kart-ust"><h3>En çok konulu kategoriler</h3></div>
    <% const enKonu = Math.max(1, ...kategoriler.map((c) => c.konu)); %>
    <% for (const c of kategoriler) { %>
      <div class="yn-cubuk-satir"><span><%= c.name %></span><span class="yn-cubuk"><i style="width: <%= Math.round(c.konu / enKonu * 100) %>%"></i></span><small><%= c.konu %> konu · <%= c.mesaj %> mesaj</small></div>
    <% } %>
  </div>
  <div class="kart yn-kart">
    <div class="yn-kart-ust"><h3>Çevrimiçi (son 5 dk)</h3></div>
    <% if (!cevrimici.length) { %><p class="ikincil kucuk">Şu an kimse görünmüyor.</p><% } %>
    <div class="yn-etiketler"><% for (const c of cevrimici) { %><a class="cip-cerceveli" href="/profil/<%= c.username %>"><%= c.username %></a><% } %></div>
  </div>
</section>

<section class="yn-izgara-2">
  <div class="kart yn-kart">
    <div class="yn-kart-ust"><h3>Son bekleyen şikâyetler</h3><a class="baglanti kucuk" href="/yonetim/sikayetler">Tümü</a></div>
    <% if (!bekleyenler.length) { %><p class="ikincil kucuk">Bekleyen şikâyet yok.</p><% } %>
    <% for (const b of bekleyenler) { %>
      <div class="yn-liste-satir">
        <span class="etiket"><%= turEtiket[b.hedef_tur] %></span>
        <span class="yn-kisa"><%= b.hedef ? (b.hedef.icerik ? b.hedef.icerik : b.hedef.yazar) : "(bulunamadı)" %></span>
        <small class="ikincil"><%= b.sebep %> · <%= b.bildiren %> · <%= zaman(b.created_at) %></small>
      </div>
    <% } %>
  </div>
  <% if (kullanici.rol === "admin") { %>
  <div class="kart yn-kart">
    <div class="yn-kart-ust"><h3>Son işlemler</h3><a class="baglanti kucuk" href="/yonetim/islem-kaydi">Tümü</a></div>
    <% if (!sonIslemler.length) { %><p class="ikincil kucuk">Henüz işlem yok.</p><% } %>
    <% for (const i of sonIslemler) { %>
      <div class="yn-liste-satir"><strong><%= eylemEtiketleri[i.eylem] || i.eylem %></strong><small class="ikincil"><%= i.aktor || "—" %> · <%= zaman(i.created_at) %></small></div>
    <% } %>
  </div>
  <% } %>
</section>
<%- include("duzen-alt") %>
