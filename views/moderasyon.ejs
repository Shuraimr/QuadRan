<%# Moderation report queue: /moderasyon?durum=bekliyor|islendi|reddedildi|hepsi   (moderator and admin only)
   Expected data:
   durum      "bekliyor" | "islendi" | "reddedildi" | "hepsi"   selected filter (defaults to bekliyor = pending)
   ozet       { bekleyen, bugun_islenen, toplam }               counts from the reports table
   sikayetler [ {
       id, durum, sebep, aciklama, created_at,          reports: sebep, aciklama, durum, created_at
       bildiren,                                        reports.reporter_id -> users.username
       ayni_post_sayisi,                                how many reports the same target has (this one included)
       tur,                                             reports.hedef_tur: "konu_mesaji" | "kullanici" | "sohbet_mesaji" | "ozel_mesaj" | "oda_mesaji"
       hedef: {                                         src/sikayet.ts hedefOnizleme()
         yazar, rutbe, banli, icerik, tarih, silindi,   the reported person (in a user report, the person themselves) and the content
         link,                                          address of the content ("" = private message, no address)
         konu: { id, title },                           only konu_mesaji
         alici, baglam: [ { gonderen, icerik, hedef, silindi, tarih } ]   only ozel_mesaj: the reported message and its surroundings
       }
   } ]
   locals.kullanici { username, rol }  if rol is not "admin" or "moderator", an access-denied message is shown
   Forms (all POST, no fields, the id is in the URL):
     /moderasyon/<id>/sil     deletes the content (topic/chat/private message; deleted_at) and marks the report "islendi" (processed)
     /moderasyon/<id>/uyar    warns the author and marks the report "islendi"
     /moderasyon/<id>/reddet  closes the report ("reddedildi" = rejected)
     /moderasyon/<id>/uzaklastir  suspends the reported person (the main action in a user report) %>
<%#
  Moderasyon şikâyet kuyruğu: /moderasyon?durum=bekliyor|islendi|reddedildi|hepsi   (yalnızca moderator ve admin)
  Beklenen veriler:
  durum      "bekliyor" | "islendi" | "reddedildi" | "hepsi"   seçili filtre (yoksa bekliyor)
  ozet       { bekleyen, bugun_islenen, toplam }               reports tablosundan sayılar
  sikayetler [ {
      id, durum, sebep, aciklama, created_at,          reports: sebep, aciklama, durum, created_at
      bildiren,                                        reports.reporter_id -> users.username
      ayni_post_sayisi,                                aynı hedefe kaç şikâyet var (bu dahil)
      tur,                                             reports.hedef_tur: "konu_mesaji" | "kullanici" | "sohbet_mesaji" | "ozel_mesaj" | "oda_mesaji"
      hedef: {                                         src/sikayet.ts hedefOnizleme()
        yazar, rutbe, banli, icerik, tarih, silindi,   şikâyet edilen kişi (kullanıcı şikâyetinde kişinin kendisi) ve içerik
        link,                                          içeriğin adresi ("" = özel mesaj, adres yok)
        konu: { id, title },                           yalnızca konu_mesaji
        alici, baglam: [ { gonderen, icerik, hedef, silindi, tarih } ]   yalnızca ozel_mesaj: şikâyet edilen mesaj ve çevresi
      }
  } ]
  locals.kullanici { username, rol }  rol "admin" ya da "moderator" değilse erişim yok mesajı gösterilir
  Formlar (hepsi POST, alan yok, id adreste):
    /moderasyon/<id>/sil     içeriği siler (konu/sohbet/özel mesaj; deleted_at) ve şikâyeti "islendi" yapar
    /moderasyon/<id>/uyar    yazarı uyarır ve şikâyeti "islendi" yapar
    /moderasyon/<id>/reddet  şikâyeti kapatır ("reddedildi")
    /moderasyon/<id>/uzaklastir  şikâyet edilen kişiyi uzaklaştırır (kullanıcı şikâyetinde asıl işlem)
%>
<%- include("partials/bas", { baslik: "Moderasyon" }) %>
<%- include("partials/ust-cubuk") %>
<%
  const mdYetkili = locals.kullanici && ["admin", "moderator"].includes(locals.kullanici.rol);
  const mdDurum = ["bekliyor", "islendi", "reddedildi", "hepsi"].includes(locals.durum) ? locals.durum : "bekliyor";
  const mdOzet = Object.assign({ bekleyen: 0, bugun_islenen: 0, toplam: 0 }, locals.ozet || {});
  const mdListe = locals.sikayetler || [];
  const mdFiltreler = [
    { ad: "bekliyor", etiket: "Bekleyen" },
    { ad: "islendi", etiket: "İşlendi" },
    { ad: "reddedildi", etiket: "Reddedildi" },
    { ad: "hepsi", etiket: "Tümü" }
  ];
  const mdDurumEtiketi = { bekliyor: "Bekliyor", islendi: "İşlendi", reddedildi: "Reddedildi" };
  const mdBosMetin = { bekliyor: "Bekleyen şikâyet yok", islendi: "İşlenmiş şikâyet yok", reddedildi: "Reddedilmiş şikâyet yok", hepsi: "Şikâyet yok" };
%>
<main class="moderasyon-sayfa">
  <% if (!mdYetkili) { %>
    <div class="kart moderasyon-erisim">
      <%- include("partials/ikon", { ad: "kilit", boyut: 32 }) %>
      <h1>Bu sayfaya erişimin yok</h1>
      <p class="ikincil">Moderasyon kuyruğunu yalnızca moderatörler ve yöneticiler görebilir.</p>
      <a class="buton buton-tonal" href="/">Akışa dön</a>
    </div>
  <% } else { %>
    <h1>Moderasyon</h1>

    <section class="moderasyon-sayaclar" aria-label="Özet">
      <div class="kart moderasyon-sayac vurgulu"><strong><%= mdOzet.bekleyen %></strong><span>Bekleyen</span></div>
      <div class="kart moderasyon-sayac"><strong><%= mdOzet.bugun_islenen %></strong><span>Bugün işlenen</span></div>
      <div class="kart moderasyon-sayac"><strong><%= mdOzet.toplam %></strong><span>Toplam</span></div>
    </section>

    <nav class="moderasyon-filtre" aria-label="Durum filtresi">
      <div class="siralama">
        <% for (const f of mdFiltreler) { %>
          <a class="<%= mdDurum === f.ad ? 'aktif' : '' %>" href="/moderasyon?durum=<%= f.ad %>" <% if (mdDurum === f.ad) { %>aria-current="page"<% } %>><%= f.etiket %></a>
        <% } %>
      </div>
    </nav>

    <% if (mdListe.length === 0) { %>
      <div class="kart bos">
        <%- include("partials/ikon", { ad: "onay", boyut: 28 }) %>
        <p><%= mdBosMetin[mdDurum] %></p>
      </div>
    <% } else { %>
      <div class="moderasyon-liste">
        <% for (const s of mdListe) { %>
          <article class="kart moderasyon-kart" aria-label="Şikâyet <%= s.id %>">
            <div class="moderasyon-kart-ust">
              <span class="moderasyon-sebep"><%= s.sebep %></span>
              <% if (s.ayni_post_sayisi > 1) { %><span class="moderasyon-sayi"><%= s.ayni_post_sayisi %> kişi şikâyet etti</span><% } %>
              <span class="moderasyon-durum"><%= mdDurumEtiketi[s.durum] || s.durum %></span>
            </div>

            <% const h = s.hedef; %>
            <% if (s.tur === "kullanici") { %>
              <div class="moderasyon-icerik">
                <div class="gonderi-meta">
                  <span class="avatar"><%= h.yazar[0] %></span>
                  <a class="kullanici" href="/profil/<%= h.yazar %>"><%= h.yazar %></a>
                  <% if (h.rutbe) { %><%- include("partials/rutbe", { rutbeAd: h.rutbe, rutbeId: h.rutbe_id }) %><% } %>
                  <span class="cip-cerceveli">Kullanıcı şikâyeti</span>
                  <% if (h.banli) { %><span class="cip-cerceveli">Uzaklaştırıldı</span><% } %>
                </div>
                <a class="baglanti kucuk" href="/profil/<%= h.yazar %>">Profili aç</a>
              </div>
            <% } else { %>
            <div class="moderasyon-icerik <%= h.silindi ? 'silinmis-icerik' : '' %>">
              <div class="gonderi-meta">
                <span class="avatar"><%= h.yazar[0] %></span>
                <a class="kullanici" href="/profil/<%= h.yazar %>"><%= h.yazar %></a>
                <% if (h.rutbe) { %><%- include("partials/rutbe", { rutbeAd: h.rutbe, rutbeId: h.rutbe_id }) %><% } %>
                <% if (s.tur === "sohbet_mesaji") { %><span class="cip-cerceveli">Genel sohbet</span><% } %>
                <% if (s.tur === "ozel_mesaj") { %><span class="cip-cerceveli">Özel mesaj → <%= h.alici %></span><% } %>
                <% if (s.tur === "oda_mesaji") { %><span class="cip-cerceveli">Oda: <%= h.oda %></span><% } %>
                <%# No time separator (same reason as gonderi-karti.ejs): so a lone "·" is not left at the start when the line wraps · Zaman ayraçsız (gonderi-karti.ejs ile aynı neden): satır kırılınca başta tek "·" kalmasın %><span class="zaman"><%= zaman(h.tarih) %></span>
              </div>
              <% if (s.tur === "ozel_mesaj" || s.tur === "oda_mesaji") { %>
                <%# PRIVACY: only the reported part of a private message and a few messages around it are shown, not the whole conversation %>
                <%# GİZLİLİK: özel mesajın yalnızca şikâyet edilen kısmı ve çevresindeki birkaç mesaj gösterilir, konuşmanın tamamı değil %>
                <div class="moderasyon-baglam" aria-label="Konuşmanın şikâyet edilen mesaj çevresi">
                  <% for (const b of h.baglam) { %>
                    <div class="moderasyon-baglam-satir<%= b.hedef ? ' hedef' : '' %><%= b.silindi ? ' silinmis-icerik' : '' %>"><strong><%= b.gonderen %></strong> <span><%= b.icerik %></span></div>
                  <% } %>
                </div>
                <p class="ikincil kucuk">Gizlilik için <%= s.tur === "oda_mesaji" ? "odanın" : "konuşmanın" %> yalnızca bu bölümü gösterilir.</p>
              <% } else { %>
                <div class="metin"><%= h.silindi ? "Bu mesaj silindi." : h.icerik %></div>
                <% if (s.tur === "konu_mesaji") { %>
                  <a class="baglanti kucuk" href="<%= h.link %>">Konu: <%= h.konu.title %></a>
                <% } else { %>
                  <a class="baglanti kucuk" href="<%= h.link %>">Sohbette göster</a>
                <% } %>
              <% } %>
            </div>
            <% } %>

            <p class="moderasyon-aciklama">
              <strong><%= s.bildiren %></strong> <%= zaman(s.created_at) %> bildirdi<% if (s.aciklama) { %>: “<%= s.aciklama %>”<% } %>
            </p>

            <% if (s.durum === "bekliyor") { %>
              <div class="moderasyon-eylem">
                <% if (s.tur !== "kullanici" && !s.hedef.silindi) { %>
                  <form method="post" action="/moderasyon/<%= s.id %>/sil"><input type="hidden" name="_csrf" value="<%= locals.csrf %>"><button class="buton buton-tehlikeli">Mesajı sil</button></form>
                <% } %>
                <form method="post" action="/moderasyon/<%= s.id %>/uyar"><input type="hidden" name="_csrf" value="<%= locals.csrf %>"><button class="buton buton-tonal">Uyar</button></form>
                <% if (!s.hedef.banli) { %>
                  <form method="post" action="/moderasyon/<%= s.id %>/uzaklastir"><input type="hidden" name="_csrf" value="<%= locals.csrf %>"><button class="buton buton-tehlikeli">Uzaklaştır</button></form>
                <% } %>
                <form method="post" action="/moderasyon/<%= s.id %>/reddet"><input type="hidden" name="_csrf" value="<%= locals.csrf %>"><button class="buton buton-cerceveli">Reddet</button></form>
              </div>
            <% } %>
          </article>
        <% } %>
      </div>
    <% } %>
  <% } %>
</main>
<%- include("partials/son") %>
