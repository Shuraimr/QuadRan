<%- include("partials/bas") %>
  <%- include("partials/ust-cubuk") %>
  <%# ?akis=takip seçiliyken kategori ve sıralama bağlantıları da bunu korur (giriş yoksa takipAkisi hep false) %>
  <% const akisEki = locals.takipAkisi ? "&akis=takip" : ""; %>

  <div class="govde govde-akis">
    <main class="sutun">
      <%
        // Akış kontrolü TEK satır: segment (Öne çıkan · Yeni · Takip) + Kategori düğmesi. Seçili kategori her bağlantıda korunur.
        // Öne çıkan = popüler sıralama; Takip = takip ettiklerimin konuları, yeni sırasıyla (src/rotalar/forum.ts).
        const katEki_ = locals.kategoriId ? "&kategori=" + kategoriId : "";
        const takipMi_ = !!locals.takipAkisi;
        const kip_ = takipMi_ ? "takip" : (locals.sirala === "populer" ? "populer" : "yeni");
        // Misafir Takip'e dokunursa girişe gider, girişten sonra aynı akışa döner
        const takipAdresi_ = locals.kullanici ? "/?akis=takip" + katEki_ : "/giris?don=" + encodeURIComponent("/?akis=takip" + katEki_);
        const sekmeler_ = [["populer", "Öne çıkan", "/?sirala=populer" + katEki_], ["yeni", "Yeni", "/?sirala=yeni" + katEki_], ["takip", "Takip", takipAdresi_]];
        // Kategori satırları mevcut kipi korur (takip ya da sıralama)
        const kipEki_ = takipMi_ ? "&akis=takip" : "&sirala=" + (locals.sirala || "yeni");
        const seciliKat_ = locals.kategoriId ? kategoriler.find((c) => c.id === kategoriId) : null;
      %>
      <div class="akis-kontrol">
        <div class="siralama akis-segment" role="group" aria-label="Akış">
          <% for (const [kod_, etiket_, adres_] of sekmeler_) { %>
            <a class="<%= kip_ === kod_ ? 'aktif' : '' %>" href="<%= adres_ %>"<%- kip_ === kod_ ? ' aria-current="true"' : '' %>>
              <% if (kip_ === kod_) { %><%- include("partials/ikon", { ad: "onay", boyut: 16 }) %><% } %>
              <%= etiket_ %>
            </a>
          <% } %>
        </div>
        <%# JS'siz: /kategoriler sayfasına gider. JS varsa quadran.js aynı listeyi (#kategori-secici) açar. Masaüstünde gizli: sol menüde kategoriler zaten var (tekrar olmasın). %>
        <a class="kategori-dugmesi<%= seciliKat_ ? ' secili' : '' %>" href="/kategoriler" data-kategori-ac aria-haspopup="dialog" aria-label="Kategori<%= seciliKat_ ? ': ' + seciliKat_.name : '' %>">
          <span class="kategori-dugmesi-ad"><%= seciliKat_ ? seciliKat_.name : "Kategori" %></span>
          <%- include("partials/ikon", { ad: "asagi-ok", boyut: 16 }) %>
        </a>
      </div>
      <div class="acilir-menu kategori-secici" id="kategori-secici" popover aria-label="Kategori">
        <div class="kategori-secici-baslik">Kategori</div>
        <a class="kategori-satir<%= !locals.kategoriId ? ' aktif' : '' %>" href="/?<%= kipEki_.slice(1) %>"<%- !locals.kategoriId ? ' aria-current="true"' : '' %>>
          <span class="kategori-satir-ad">Tümü</span>
          <% if (!locals.kategoriId) { %><%- include("partials/ikon", { ad: "onay", boyut: 20 }) %><% } %>
        </a>
        <% for (const kategori of kategoriler) { const sec_ = locals.kategoriId === kategori.id; %>
          <a class="kategori-satir<%= sec_ ? ' aktif' : '' %>" href="/?kategori=<%= kategori.id %><%= kipEki_ %>"<%- sec_ ? ' aria-current="true"' : '' %>>
            <span class="kategori-satir-ad"><%= kategori.name %></span>
            <span class="kategori-satir-sayi"><%= Number(kategori.konu_sayisi).toLocaleString("tr-TR") %> konu</span>
            <% if (sec_) { %><%- include("partials/ikon", { ad: "onay", boyut: 20 }) %><% } %>
          </a>
        <% } %>
      </div>

      <% if (konular.length === 0 && locals.takipAkisi) { %>
        <div class="kart bos">
          Takip ettiğin kimse yok ya da henüz konu açmadılar.
          <a class="baglanti" href="/siralama">Kimleri takip edebileceğine bak</a>
        </div>
      <% } else if (konular.length === 0) { %>
        <div class="kart bos">
          <%= locals.kategoriId ? "Bu kategoride henüz konu yok." : "Henüz konu yok." %>
          <a class="baglanti" href="/konu/yeni<%= locals.kategoriId ? '?kategori=' + kategoriId : '' %>">İlk konuyu sen aç.</a>
        </div>
      <% } %>
      <% for (const konu of konular) { %>
        <%- include("partials/gonderi-karti", { konu }) %>
      <% } %>
    </main>

    <aside class="sutun sag-panel">
      <% if (!locals.kullanici) { %>
      <section class="kart panel katil">
        <span class="logo-isaret">Q</span>
        <h3>QuadRan'a katıl</h3>
        <p>Oy ver, yorum yaz, rütbeni yükselt. Topluluğun standartlarını birlikte belirleyelim.</p>
        <a class="buton buton-birincil buton-genis" href="/kayit">Kayıt ol</a>
        <a class="buton buton-cerceveli buton-genis" href="/giris">Giriş yap</a>
      </section>
      <% } %>

      <section class="kart panel">
        <h3>Genel sohbet</h3>
        <% for (const mesaj of sohbet) { %>
          <div class="sohbet-satiri">
            <%- include("partials/avatar", { ad: mesaj.yazar, url: mesaj.avatar_url, sus: mesaj.avatar_susu, bos: true }) %>
            <div>
              <div class="ad"><%= mesaj.yazar %></div>
              <div class="mesaj"><%= mesaj.content %></div>
            </div>
          </div>
        <% } %>
        <% if (locals.kullanici) { %>
          <a class="kilitli" href="/sohbet">Sohbete katıl</a>
        <% } else { %>
        <a class="kilitli" href="/giris">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
          Yazmak için giriş yap
        </a>
        <% } %>
      </section>

      <section class="kart panel">
        <h3>En çok puan</h3>
        <% liderler.forEach((lider, i) => { %>
          <div class="lider">
            <span class="sira"><%= i + 1 %></span>
            <%- include("partials/avatar", { ad: lider.username, url: lider.avatar_url, sus: lider.avatar_susu, sinif: "avatar-orta", bos: true }) %>
            <span class="kullanici"><%= lider.username %></span>
            <% if (lider.rutbe) { %><%- include("partials/rutbe", { rutbeAd: lider.rutbe, rutbeId: lider.rutbe_id }) %><% } %>
            <span class="puan"><%= lider.points %></span>
          </div>
        <% }) %>
        <a class="baglanti" href="/siralama">Sıralamanın tamamı →</a>
      </section>
    </aside>
  </div>
<%- include("partials/son") %>
