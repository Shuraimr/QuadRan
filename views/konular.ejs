<%- include("partials/bas") %>
  <%- include("partials/ust-cubuk") %>
  <%# ?akis=takip seçiliyken kategori ve sıralama bağlantıları da bunu korur (giriş yoksa takipAkisi hep false) %>
  <% const akisEki = locals.takipAkisi ? "&akis=takip" : ""; %>

  <div class="govde govde-akis">
    <%# Masaüstü ve tabletteki kategori listesi kenar menüde; bu sütun yalnızca telefonda yatay çipler olarak kalır (CSS) %>
    <nav class="sutun akis-kategoriler" id="kategoriler" aria-label="Kategoriler">
      <div class="bolum-etiketi">KATEGORİLER</div>
      <div class="kategoriler">
        <a class="kategori-ogesi <%= !locals.kategoriId ? 'aktif' : '' %>" href="/?sirala=<%= locals.sirala || 'yeni' %><%= akisEki %>">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          Tümü
        </a>
        <% for (const kategori of kategoriler) { %>
          <a class="kategori-ogesi <%= locals.kategoriId === kategori.id ? 'aktif' : '' %>" href="/?kategori=<%= kategori.id %>&sirala=<%= locals.sirala || 'yeni' %><%= akisEki %>">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9h16M4 15h16M10 3 8 21M16 3l-2 18"/></svg>
            <%= kategori.name %>
          </a>
        <% } %>
      </div>
    </nav>

    <main class="sutun">
      <%
        // Sıralama sekmeleri seçili kategoriyi korur: /?sirala=eniyi&kategori=2
        const sekmeler = [["yeni", "Yeni"], ["populer", "Popüler"], ["eniyi", "En iyi"]];
        const suAnki = locals.sirala || "yeni";
      %>
      <div class="akis-kontrol">
      <%# Herkes | Takip ettiklerin: yalnızca giriş yapmış kişide. Sıralama ve kategori seçimi korunur. %>
      <% if (locals.kullanici) { %>
        <div class="siralama" role="group" aria-label="Akış kaynağı">
          <% for (const [ad, etiket] of [["", "Herkes"], ["takip", "Takip ettiklerin"]]) { %>
            <% const secili = (ad === "takip") === !!locals.takipAkisi; %>
            <a class="<%= secili ? 'aktif' : '' %>" href="/?sirala=<%= suAnki %><%= locals.kategoriId ? '&kategori=' + kategoriId : '' %><%= ad ? '&akis=' + ad : '' %>"<%- secili ? ' aria-current="true"' : '' %>>
              <% if (secili) { %><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg><% } %>
              <%= etiket %>
            </a>
          <% } %>
        </div>
      <% } %>
      <div class="siralama">
        <% for (const [ad, etiket] of sekmeler) { %>
          <a class="<%= suAnki === ad ? 'aktif' : '' %>" href="/?sirala=<%= ad %><%= locals.kategoriId ? '&kategori=' + kategoriId : '' %><%= akisEki %>">
            <% if (suAnki === ad) { %><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg><% } %>
            <%= etiket %>
          </a>
        <% } %>
      </div>
      </div>

      <% if (konular.length === 0 && locals.takipAkisi) { %>
        <div class="kart bos">
          Takip ettiğin kimse yok ya da henüz konu açmadılar.
          <a class="baglanti" href="/siralama">Kimleri takip edebileceğine bak</a>
        </div>
      <% } else if (konular.length === 0) { %>
        <div class="kart bos">
          <%= locals.kategoriId ? "Bu kategoride henüz konu yok." : "Henüz konu yok." %>
          <a class="baglanti" href="/konu/yeni<%= locals.kategoriId ? '?kategori=' + kategoriId : '' %>">İlk konuyu sen aç.</a>
        </div>
      <% } %>
      <% for (const konu of konular) { %>
        <%- include("partials/gonderi-karti", { konu }) %>
      <% } %>
    </main>

    <aside class="sutun sag-panel">
      <% if (!locals.kullanici) { %>
      <section class="kart panel katil">
        <span class="logo-isaret">Q</span>
        <h3>QuadRan'a katıl</h3>
        <p>Oy ver, yorum yaz, rütbeni yükselt. Topluluğun standartlarını birlikte belirleyelim.</p>
        <a class="buton buton-birincil buton-genis" href="/kayit">Kayıt ol</a>
        <a class="buton buton-cerceveli buton-genis" href="/giris">Giriş yap</a>
      </section>
      <% } %>

      <section class="kart panel">
        <h3>Genel sohbet</h3>
        <% for (const mesaj of sohbet) { %>
          <div class="sohbet-satiri">
            <%- include("partials/avatar", { ad: mesaj.yazar, url: mesaj.avatar_url, sus: mesaj.avatar_susu, bos: true }) %>
            <div>
              <div class="ad"><%= mesaj.yazar %></div>
              <div class="mesaj"><%= mesaj.content %></div>
            </div>
          </div>
        <% } %>
        <% if (locals.kullanici) { %>
          <a class="kilitli" href="/sohbet">Sohbete katıl</a>
        <% } else { %>
        <a class="kilitli" href="/giris">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
          Yazmak için giriş yap
        </a>
        <% } %>
      </section>

      <section class="kart panel">
        <h3>En çok puan</h3>
        <% liderler.forEach((lider, i) => { %>
          <div class="lider">
            <span class="sira"><%= i + 1 %></span>
            <%- include("partials/avatar", { ad: lider.username, url: lider.avatar_url, sus: lider.avatar_susu, sinif: "avatar-orta", bos: true }) %>
            <span class="kullanici"><%= lider.username %></span>
            <% if (lider.rutbe) { %><%- include("partials/rutbe", { rutbeAd: lider.rutbe, rutbeId: lider.rutbe_id }) %><% } %>
            <span class="puan"><%= lider.points %></span>
          </div>
        <% }) %>
        <a class="baglanti" href="/siralama">Sıralamanın tamamı →</a>
      </section>
    </aside>
  </div>
<%- include("partials/son") %>
