<%#
  Shared status page: 403, 404, 429, 500, 503 (Figma "09 · Hata ve durum sayfaları"). Rendered by: durumSayfasi() (src/yardimci.ts), the server.ts 404/error handlers.
  Expected data:
  kod     403 | 404 | 429 | 500 | 503
  metin   (optional) replaces the default description; on 503 the maintenance note also comes from here
  saniye  (429 only) remaining time
  sade    (optional) if true, rendered without menus; 503 is always menu-less, and so is 500 when the shared data could not be prepared (database error)
  Normal pages use the site layout (top bar + menus) so the person does not get lost; menus make no sense on the maintenance page (you cannot sign in), so it stays plain.

  Ortak durum sayfası: 403, 404, 429, 500, 503 (Figma "09 · Hata ve durum sayfaları"). Çizen: durumSayfasi() (src/yardimci.ts), server.ts 404/hata işleyicileri.
  Beklenen veriler:
  kod     403 | 404 | 429 | 500 | 503
  metin   (isteğe bağlı) varsayılan açıklamanın yerine geçer; 503'te bakım notu da buradan gelir
  saniye  (yalnızca 429) kalan süre
  sade    (isteğe bağlı) true ise menüsüz çizilir; 503 her zaman menüsüz, 500'de ortak veriler hazırlanamadıysa (veritabanı hatası) da menüsüz
  Normal sayfalar site düzeniyle (üst çubuk + menüler) çizilir ki kişi kaybolmasın; bakım sayfasında menü anlamsız (giremezsin), sade kalır.
%>
<%
  const AKISA = { href: "/", etiket: "Akışa dön", tur: "tonal" };
  const DURUMLAR = {
    404: { etiket: "Sayfa yok", ikon: "pusula", baslik: "Bu sayfa bulunamadı", metin: "Adres değişmiş ya da sayfa kaldırılmış olabilir. Aradığın şeyi aşağıdan bulabilirsin.", arama: true, eylemler: [{ href: "/", etiket: "Akışa dön", tur: "cerceveli" }] },
    403: { etiket: "Yetki yok", ikon: "kilit", baslik: "Bu sayfaya erişimin yok", metin: "Bu bölüm yalnızca yetkili hesaplara açık.", eylemler: [AKISA] },
    429: { etiket: "Çok fazla istek", ikon: "kumsaati", baslik: "Biraz yavaşla", metin: "Kısa sürede çok fazla istek geldi. Az sonra kaldığın yerden devam edebilirsin.",
           eylemler: [{ href: locals.yenileAdresi || "/", etiket: "Şimdi tekrar dene", tur: "birincil", geriSayimBitti: true }, AKISA] },
    500: { etiket: "Sunucu hatası", ikon: "uyari", baslik: "Bir şeyler ters gitti", metin: "Sayfa yüklenemedi. Sorun bizde; birkaç saniye sonra tekrar dene.", eylemler: [{ href: locals.yenileAdresi || "/", etiket: "Sayfayı yenile", tur: "birincil" }, AKISA] },
    503: { etiket: "Bakım", ikon: "anahtar", baslik: "Kısa bir bakımdayız", metin: "Site güncelleniyor.", eylemler: [{ href: "/giris", etiket: "Yetkili girişi", tur: "cerceveli" }] },
  };
  const d = Object.assign({}, DURUMLAR[kod] || DURUMLAR[500]);
  if (locals.metin) d.metin = kod === 503 ? "Site güncelleniyor. " + metin : metin;
  const menusuz = kod === 503 || !!locals.sade;
  // On 404 suggest categories to the lost visitor (only if shared data is ready; not on menu-less/error pages)
  // 404'te kayıp kişiye kategoriler önerilir (ortak veriler hazırsa; menüsüz/hata sayfasında yok)
  const veri_ = Object.assign({}, d, { kod, saniye: locals.saniye, kategoriler: kod === 404 && !menusuz ? (locals.menuKategoriler || []) : [] });
%>
<%- include("partials/bas", { sade: menusuz, baslik: d.baslik }) %>
<% if (menusuz) { %>
  <div class="orta-sayfa">
    <a class="logo" href="/"><span class="logo-isaret"><img src="/img/marka/rakun-96.webp" alt="" width="32" height="32"></span><span class="logo-yazi">rubyyard</span></a>
    <%- include("partials/durum-icerik", veri_) %>
  </div>
<% } else { %>
  <%- include("partials/ust-cubuk") %>
  <main class="durum-sayfa">
    <%- include("partials/durum-icerik", veri_) %>
  </main>
<% } %>
<%- include("partials/son", { sade: menusuz }) %>
