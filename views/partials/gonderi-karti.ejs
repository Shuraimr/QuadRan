<article class="kart gonderi"<%- konu.ilk_post_id ? " id=\"mesaj-" + konu.ilk_post_id + "\"" : "" %>>
  <div class="oy">
    <% if (konu.ilk_post_id) { %>
      <%- include("oy", { hedef: { id: konu.ilk_post_id, skor: konu.skor, benim_oyum: konu.benim_oyum } }) %>
    <% } else { %>
      <button class="ikon-dugme" aria-label="Yukarı oy ver">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 7-7 7 7"/><path d="M12 19V5"/></svg>
      </button>
      <span class="skor"><%= konu.skor ?? 0 %></span>
      <button class="ikon-dugme" aria-label="Aşağı oy ver">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
      </button>
    <% } %>
  </div>
  <div class="gonderi-icerik">
    <div class="gonderi-meta">
      <span class="etiket"><%= konu.kategori %></span>
      <% if (konu.pinned_at) { %><span class="etiket">Sabit</span><% } %>
      <% if (konu.cozuldu) { %><span class="cozum-cip"><%- include("ikon", { ad: "onay", boyut: 13 }) %>Çözüldü</span><% } %>
      <%# Yazarın adı ve avatarı üye kartını açar (JS yoksa profile gider; quadran.js data-uye-karti) %>
      <%- include("avatar", { ad: konu.yazar, url: konu.avatar_url, sus: konu.avatar_susu, etiket: "a", href: "/profil/" + encodeURIComponent(konu.yazar), ek: 'data-uye-karti="' + konu.yazar.replace(/"/g, "") + '" tabindex="-1"', bos: true }) %>
      <a class="kullanici" href="/profil/<%= encodeURIComponent(konu.yazar) %>" data-uye-karti="<%= konu.yazar %>"><%= konu.yazar %></a>
      <% if (konu.rutbe) { %><%- include("rutbe", { rutbeAd: konu.rutbe, rutbeId: konu.rutbe_id }) %><% } %>
      <%- include("unvan", { unvan: konu.unvan, premium: konu.premium }) %>
      <%# Zaman ayraçsız: satır kırılınca başta yalnız bir "·" kalıyordu; aradaki boşluk (gap) yeterli ayraç %><span class="zaman"><%= zaman(konu.created_at) %></span>
    </div>
    <h2><a href="/konu/<%= konu.id %>"><%= konu.title %></a></h2>
    <% if (konu.ozet) { %><p class="ozet"><%= konu.ozet %></p><% } %>
    <div class="gonderi-eylem">
      <a class="eylem" href="/konu/<%= konu.id %>">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
        <%= konu.yorum_sayisi %> yorum
      </a>
      <a class="eylem" href="/konu/<%= konu.id %>" data-paylas data-baslik="<%= konu.title %>">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="m16 6-4-4-4 4"/><path d="M12 2v13"/></svg>
        Paylaş
      </a>
    </div>
  </div>
</article>
