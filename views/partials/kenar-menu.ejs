<%#
  Kenar menü: tek kaynak, iki görünüm (CSS'te).
  801-1180px: 88px'lik simge rayı (FAB + simgeler). 1181px ve üstü: 248px'lik etiketli kalıcı sol kenar çubuğu,
  Kategoriler'in altında kategori listesiyle (rayda gizli). Telefonda görünmez (orada alt menü var).
  Beklenen veriler (hepsi isteğe bağlı):
  menuKategoriler  [ { id, name } ] (oturum.ts, önbellekli); kategoriId seçili kategori (yalnızca akışta)
  aktifMenu   "akis" | "kategoriler" | "sohbet" | "siralama" | "ayarlar" (yoksa "akis")
  okunmamisOda  true ise Sohbet öğesinde küçük nokta (sessize alınmamış bir odada okunmamış mesaj var; src/odalar.ts)
  kullanici   giriş yapmışsa { username }; yoksa "Konu aç" ve "Ayarlar" gösterilmez
  statik      true ise sayfanın içinde sabit olmadan gösterilir (yalnızca önizleme sayfası için)
%>
<% const kategoriId_ = locals.kategoriId || 0;
   // Kategori seçiliyken akış öğesi aktif sayılmaz: seçili olan kategori satırıdır
   const aktifMenu_ = (locals.aktifMenu || "akis") === "akis" && kategoriId_ ? "kategoriler" : (locals.aktifMenu || "akis"); const uye_ = !!locals.kullanici;
   const ogeler_ = [
     { id: "akis", ad: "Akış", href: "/", ikon: "ev" },
     { id: "kategoriler", ad: "Kategoriler", href: "/kategoriler", ikon: "izgara" },
     { id: "sohbet", ad: "Sohbet", href: "/sohbet", ikon: "sohbet" },
     { id: "siralama", ad: "Sıralama", href: "/siralama", ikon: "kupa" }
   ]; %>
<nav class="kenar-menu<%= locals.statik ? ' katman-statik' : '' %>" aria-label="Ana gezinti">
  <% if (uye_) { %>
    <a class="kenar-menu-fab" href="/konu/yeni" aria-label="Konu aç"><%- include("ikon", { ad: "kalem", boyut: 24 }) %></a>
  <% } %>
  <div class="kenar-menu-liste">
    <% for (const o of ogeler_) { %>
      <%# Kategori seçiliyken "Kategoriler" yalnızca rayda (tablet) aktif görünür; geniş çubukta aktif olan alt satırdır (.kisa-aktif) %>
      <a class="menu-ogesi<%= aktifMenu_ === o.id ? (o.id === 'kategoriler' && kategoriId_ ? ' kisa-aktif' : ' aktif') : '' %>" href="<%= o.href %>"<%- aktifMenu_ === o.id && !kategoriId_ ? ' aria-current="page"' : '' %>>
        <span class="menu-hap"><%- include("ikon", { ad: o.ikon, boyut: 24 }) %><% if (o.id === "sohbet" && locals.okunmamisOda) { %><span class="menu-nokta" role="img" aria-label="Okunmamış oda mesajı var"></span><% } %></span>
        <span class="menu-etiket"><%= o.ad %></span>
      </a>
      <% if (o.id === "kategoriler" && (locals.menuKategoriler || []).length) { %>
        <div class="kenar-menu-kategoriler" role="group" aria-label="Kategoriler">
          <% for (const c of menuKategoriler) { %>
            <a class="kenar-kategori<%= kategoriId_ === c.id ? ' aktif' : '' %>" href="/?kategori=<%= c.id %>"<%- kategoriId_ === c.id ? ' aria-current="page"' : '' %>># <%= c.name %></a>
          <% } %>
        </div>
      <% } %>
    <% } %>
  </div>
  <% if (uye_) { %>
    <div class="kenar-menu-alt">
      <a class="menu-ogesi<%= aktifMenu_ === 'ayarlar' ? ' aktif' : '' %>" href="/ayarlar"<%- aktifMenu_ === "ayarlar" ? ' aria-current="page"' : '' %>>
        <span class="menu-hap"><%- include("ikon", { ad: "ayar", boyut: 24 }) %></span>
        <span class="menu-etiket">Ayarlar</span>
      </a>
    </div>
  <% } %>
</nav>
