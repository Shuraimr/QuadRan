<%#
  Boş durum: düz "henüz yok" yazısı yerine ikon + başlık + (isteğe bağlı) açıklama ve eylem. Durum sayfasının (durum-icerik.ejs) küçük kardeşi.
  Kullanım: kartın içinde include("partials/bos-durum", { ikon: "zil", baslik: "...", metin: "...", eylem: { href: "/", etiket: "..." } })
  (açıklama satırında kapanış etiketi yazılamaz: EJS yorumu orada bitirir)
  Beklenen veriler: ikon (ikon.ejs adı), baslik, metin (isteğe bağlı), eylem { href, etiket } (isteğe bağlı), dar (true: yan sütun için sıkı)
%>
<div class="bos-durum<%= locals.dar ? ' dar' : '' %>">
  <span class="bos-durum-ikon"><%- include("ikon", { ad: ikon, boyut: 22 }) %></span>
  <h2 class="bos-durum-baslik"><%= baslik %></h2>
  <% if (locals.metin) { %><p class="bos-durum-metin"><%= metin %></p><% } %>
  <% if (locals.eylem) { %><a class="buton buton-tonal" href="<%= eylem.href %>"><%= eylem.etiket %></a><% } %>
</div>
