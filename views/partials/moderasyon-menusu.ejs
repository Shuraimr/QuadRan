<%# Moderation menu (opened from the "more" button on a topic or message, a popover).
   Button: <button popovertarget="moderasyon-menusu-<post_id>" data-menu-ac> ... </button>
   Expected data (passed with include):
   post_id   id of the target message
   topic_id  id of the target topic
   kategoriler  (res.locals.tumKategoriler) for the "Change category" dropdown; on the topic page topic.category_id comes selected
   statik    if true an open box instead of a popover (only for the preview page)
   satirIci  if true its own box is not drawn: only the items are printed (the comment's ⋮ menu merges them into its own menu, no second ⋮)
   yazar_id  author of the message; "Suspend…" goes to the Sanctions tab of their admin card
   Each action goes as POST /moderasyon/<eylem>: sabitle, kilitle, kategori-degistir, sil.
   Suspension is NOT done with one click here: duration, reason, lifting and sanction history are together on the member card %>
<%#
  Moderasyon menüsü (konu veya mesaj üzerindeki "daha fazla" düğmesinden açılır, popover).
  Düğme: <button popovertarget="moderasyon-menusu-<post_id>" data-menu-ac> ... </button>
  Beklenen veriler (include ile verilir):
  post_id   hedef mesajın id'si
  topic_id  hedef konunun id'si
  kategoriler  (res.locals.tumKategoriler) "Kategoriyi değiştir" açılır listesi için; konu sayfasında konu.category_id seçili gelir
  statik    true ise popover yerine açık kutu (yalnızca önizleme sayfası için)
  satirIci  true ise kendi kutusu çizilmez: yalnızca öğeler basılır (yorumun ⋮ menüsü bunları kendi menüsüne katar, ikinci ⋮ olmaz)
  yazar_id  mesajın yazarı; "Uzaklaştır…" onun yönetim kartının Yaptırımlar sekmesine gider
  Her eylem POST /moderasyon/<eylem> olarak gider: sabitle, kilitle, kategori-degistir, sil.
  Uzaklaştırma burada tek tıkla YAPILMAZ: süre, sebep, kaldırma ve yaptırım geçmişi üye kartında bir arada
  (eskiden bu menü sebepsiz ve kalıcı uzaklaştırıyordu, geri alma yolu da görünmüyordu).
%>
<% const statik_ = !!locals.statik; const satirIci_ = !!locals.satirIci; const eylemler_ = [
  { eylem: "sabitle", ad: "Konuyu sabitle", ikon: "sabitle" },
  { eylem: "kilitle", ad: "Konuyu kilitle", ikon: "kilit" },
  { eylem: "kategori-degistir", ad: "Kategoriyi değiştir", ikon: "klasor" },
  null,
  { eylem: "sil", ad: "Mesajı sil", ikon: "cop", tehlike: true },
  { eylem: "uzaklastir", ad: "Uzaklaştır…", ikon: "yasak", tehlike: true }
]; %>
<% if (!satirIci_) { %><div class="acilir-menu moderasyon-menusu<%= statik_ ? ' katman-statik' : ' acilir-menu-konumlu' %>"<%- statik_ ? "" : ' id="moderasyon-menusu-' + (locals.post_id ?? "") + '" popover aria-label="Moderasyon işlemleri"' %>>
<% } %>
  <%# If the topic's owner is also staff, the "Pin to my profile" item is added here (konu.ejs does not draw a separate ⋮) %>
  <%# Konunun sahibi aynı zamanda yetkiliyse "Profilime sabitle" öğesi buraya eklenir (konu.ejs ayrı ⋮ çizmez) %>
  <% if (locals.sahibi) { %><%- include("profil-sabit-oge") %><hr class="acilir-ayirici"><% } %>
  <% for (const e of eylemler_) { %>
    <% if (!e) { %>
      <hr class="acilir-ayirici">
    <% } else if (e.eylem === "kategori-degistir") { %>
      <%# Category selection is inside the menu item: the list + "Move" button are the same form, no JS needed %>
      <%# Kategori seçimi menü öğesinin içinde: liste + "Taşı" düğmesi aynı form, JS gerekmez %>
      <form class="kategori-degistir-formu" method="post" action="/moderasyon/kategori-degistir"><input type="hidden" name="_csrf" value="<%= locals.csrf %>">
        <input type="hidden" name="post_id" value="<%= locals.post_id ?? '' %>">
        <input type="hidden" name="topic_id" value="<%= locals.topic_id ?? '' %>">
        <label class="acilir-oge"><%- include("ikon", { ad: e.ikon, boyut: 20 }) %>
          <select name="category_id" aria-label="Yeni kategori" required>
            <% const mevcutKat_ = locals.konu ? konu.category_id : null; %>
            <% for (const c of (locals.tumKategoriler || [])) { %>
              <option value="<%= c.id %>"<%- c.id === mevcutKat_ ? " selected" : "" %>><%= c.name %></option>
            <% } %>
          </select>
        </label>
        <button class="buton buton-tonal kategori-degistir-dugme" type="submit">Taşı</button>
      </form>
    <% } else if (e.eylem === "uzaklastir") { %>
      <% if (locals.yazar_id) { %>
        <a class="acilir-oge acilir-oge-tehlikeli" href="/yonetim/uyeler/<%= yazar_id %>?sekme=yaptirim"><%- include("ikon", { ad: e.ikon, boyut: 20 }) %><span class="acilir-ad"><%= e.ad %></span></a>
      <% } %>
    <% } else { %>
      <form method="post" action="/moderasyon/<%= e.eylem %>"><input type="hidden" name="_csrf" value="<%= locals.csrf %>">
        <input type="hidden" name="post_id" value="<%= locals.post_id ?? '' %>">
        <input type="hidden" name="topic_id" value="<%= locals.topic_id ?? '' %>">
        <button class="acilir-oge<%= e.tehlike ? ' acilir-oge-tehlikeli' : '' %>" type="submit"><%- include("ikon", { ad: e.ikon, boyut: 20 }) %><span class="acilir-ad"><%= e.ad %></span></button>
      </form>
    <% } %>
  <% } %>
  <%# +18 marker: only on a comment that has an attachment (yorum.ejs provides ekVar/nsfwMi) %>
  <%# +18 işareti: yalnızca eki olan yorumda (yorum.ejs ekVar/nsfwMi verir) %>
  <% if (locals.ekVar) { %>
    <form method="post" action="/moderasyon/nsfw"><input type="hidden" name="_csrf" value="<%= locals.csrf %>">
      <input type="hidden" name="post_id" value="<%= locals.post_id ?? '' %>">
      <input type="hidden" name="topic_id" value="<%= locals.topic_id ?? '' %>">
      <button class="acilir-oge" type="submit"><%- include("ikon", { ad: "uyari", boyut: 20 }) %><span class="acilir-ad"><%= locals.nsfwMi ? "+18 işaretini kaldır" : "+18 olarak işaretle" %></span></button>
    </form>
  <% } %>
<% if (!satirIci_) { %></div><% } %>
