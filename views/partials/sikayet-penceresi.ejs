<%#
  Şikâyet penceresi. Sayfada bir tane olur; "Şikâyet et" bağlantılarındaki data-post-id değerini JS buraya yazar.
  Bağlantı biçimi: <a href="/sikayet?post_id=7" data-sikayet-ac data-post-id="7">  (JS yoksa bağlantı olarak çalışır)
  Beklenen veriler (hepsi isteğe bağlı):
  post_id  pencere ilk açıldığında gizli alana yazılacak mesaj id'si
  statik   true ise <dialog> yerine açık kutu (yalnızca önizleme sayfası için)
%>
<% const statik_ = !!locals.statik; const etiket_ = statik_ ? "div" : "dialog";
   const sebepler_ = ["Spam veya reklam", "Hakaret veya nefret söylemi", "Konu dışı", "Başka bir sebep"]; %>
<<%= etiket_ %> class="sikayet-penceresi<%= statik_ ? ' katman-statik' : '' %>"<%- statik_ ? "" : ' id="sikayet-penceresi" aria-labelledby="sikayet-baslik"' %>>
  <form class="sikayet-form" method="post" action="/sikayet">
    <input type="hidden" name="post_id" value="<%= locals.post_id ?? '' %>">
    <h2<%- statik_ ? "" : ' id="sikayet-baslik"' %>>Bu mesajı şikâyet et</h2>
    <fieldset class="sikayet-sebepler">
      <legend class="arama-gizli-baslik">Şikâyet sebebi</legend>
      <% sebepler_.forEach((s, i) => { %>
        <label class="sikayet-secenek"><input type="radio" name="sebep" value="<%= s %>"<%- i === 1 && statik_ ? " checked" : "" %> required><span><%= s %></span></label>
      <% }) %>
    </fieldset>
    <label class="alan sikayet-not">
      <span>Not (isteğe bağlı)</span>
      <textarea name="not" maxlength="1000" placeholder="Eklemek istediğin bir şey var mı? (isteğe bağlı)"></textarea>
    </label>
    <div class="sikayet-eylemler">
      <button class="buton buton-metin" type="button" data-dialog-kapat>Vazgeç</button>
      <button class="buton buton-birincil" type="submit">Gönder</button>
    </div>
  </form>
</<%= etiket_ %>>
