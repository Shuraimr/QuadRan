<%#
  Hesap menüsü (avatardan açılır, popover). Yalnızca giriş yapmış kullanıcıya çizilir.
  Beklenen veriler:
  kullanici     { username, rutbe, points, rol }
  bekleyenSikayet  yetkililer için bekleyen şikâyet sayısı (0'dan büyükse Yönetim yanında rozet)
  okunmamisBildirim  0'dan büyükse (telefonda) Bildirimler satırında sayı
  statik        true ise popover yerine açık kutu (yalnızca önizleme sayfası için)
%>
<% if (locals.kullanici) { const k_ = locals.kullanici; const statik_ = !!locals.statik; %>
<div class="acilir-menu avatar-menusu<%= statik_ ? ' katman-statik' : ' acilir-menu-ustte' %>"<%- statik_ ? "" : ' id="avatar-menusu" popover aria-label="Hesap menüsü"' %>>
  <div class="avatar-menusu-baslik">
    <%- include("avatar", { ad: k_.username, url: k_.avatar_url, sus: k_.avatar_susu, sinif: "avatar-48", oynat: true, bos: true }) %>
    <div>
      <strong><%= k_.username %></strong>
      <div class="ikincil kucuk"><%= k_.rutbe || "Çaylak" %> · <%= k_.points ?? 0 %> puan</div>
    </div>
  </div>
  <%# Telefonda bu menü alt menüdeki Profil'den açılan hesap sayfasıdır: Yakut bölümü ve Bildirimler YALNIZCA orada durur
      (tablet/masaüstünde yakut sol menüde/rayda, bildirimler zilde; aynı şey iki yerde olmasın diye CSS gizler: .yalniz-telefon).
      Mesajlar buradan kalktı: DM'ler her ölçekte Sohbet › DM. %>
  <div class="yalniz-telefon avatar-menu-yakut"><%- include("yakut-bolumu", { tur: "hesap" }) %></div>
  <%# Sayfaya gider (açılır panel değil): panel bu menünün üstüne ikinci bir katman olarak biniyordu %>
  <a class="acilir-oge yalniz-telefon avatar-menu-bildirim" href="/bildirimler"><%- include("ikon", { ad: "zil", boyut: 20 }) %><span class="acilir-ad">Bildirimler</span>
    <% if ((locals.okunmamisBildirim || 0) > 0) { %><span class="acilir-rozet" aria-label="<%= locals.okunmamisBildirim %> okunmamış bildirim"><%= locals.okunmamisBildirim > 99 ? "99+" : locals.okunmamisBildirim %></span><% } %>
  </a>
  <a class="acilir-oge" href="/profil/<%= k_.username %>"><%- include("ikon", { ad: "kisi", boyut: 20 }) %><span class="acilir-ad">Profilim</span></a>
  <a class="acilir-oge avatar-menu-ayarlar" href="/ayarlar" data-ayarlar-kisayol><%- include("ikon", { ad: "ayar", boyut: 20 }) %><span class="acilir-ad">Ayarlar</span><span class="acilir-kisayol">Ctrl ,</span></a>
  <% if (["admin", "moderator"].includes(k_.rol)) { %>
    <a class="acilir-oge" href="/yonetim"><%- include("ikon", { ad: "kalkan", boyut: 20 }) %><span class="acilir-ad">Yönetim</span>
      <% if ((locals.bekleyenSikayet || 0) > 0) { %><span class="acilir-rozet" aria-label="<%= locals.bekleyenSikayet %> bekleyen şikâyet"><%= locals.bekleyenSikayet %></span><% } %>
    </a>
  <% } %>
  <hr class="acilir-ayirici">
  <form method="post" action="/cikis"><input type="hidden" name="_csrf" value="<%= locals.csrf %>">
    <button class="acilir-oge acilir-oge-tehlikeli" type="submit"><%- include("ikon", { ad: "cikis", boyut: 20 }) %><span class="acilir-ad">Çıkış yap</span></button>
  </form>
</div>
<% } %>
