<%#
  Mobil alt menü (en çok 800px genişlikte görünür, CSS'te).
  Beklenen veriler (hepsi isteğe bağlı):
  aktifMenu          "akis" | "kesfet" | "konu-ac" | "sohbet" | "giris" | "profil" (yoksa "akis")
  kullanici          giriş yapmışsa { username }
  okunmamisOda       true ise Sohbet üzerinde küçük nokta (okunmamış oda mesajı)
  okunmamisBildirim  0'dan büyükse Bildirimler üzerinde küçük nokta çıkar
  statik             true ise sabit olmadan gösterilir (yalnızca önizleme sayfası için)
%>
<% const aktifMenu_ = locals.aktifMenu || "akis";
   /* Kategoriler ve Sıralama telefonda Keşfet sayfasından açılır (2 dokunuş); Ara da orada. Bildirimler üst çubukta (zil). */
   const ogeler_ = locals.kullanici ? [
     { id: "akis", ad: "Akış", href: "/", ikon: "ev" },
     { id: "kesfet", ad: "Keşfet", href: "/kesfet", ikon: "pusula" },
     { id: "konu-ac", ad: "Konu aç", href: "/konu/yeni", ikon: "kalem" },
     { id: "sohbet", ad: "Sohbet", href: "/sohbet", ikon: "sohbet" },
     /* Profil hesap menüsünü açar (Profilim, Ayarlar, Yönetim, Çıkış): bu menüler telefonda başka yerde yok */
     { id: "profil", ad: "Profil", href: "/profil/" + locals.kullanici.username, ikon: "kisi", hesapMenusu: true }
   ] : [
     { id: "akis", ad: "Akış", href: "/", ikon: "ev" },
     { id: "kesfet", ad: "Keşfet", href: "/kesfet", ikon: "pusula" },
     { id: "sohbet", ad: "Sohbet", href: "/sohbet", ikon: "sohbet" },
     { id: "giris", ad: "Giriş", href: "/giris", ikon: "giris" }
   ]; %>
<nav class="alt-menu<%= locals.statik ? ' katman-statik' : '' %>" aria-label="Alt gezinti"<%- locals.statik ? "" : " data-alt-cubuk" %>>
  <% for (const o of ogeler_) { %>
    <% if (o.hesapMenusu) { %>
    <button class="menu-ogesi<%= aktifMenu_ === o.id ? ' aktif' : '' %>" type="button" popovertarget="avatar-menusu" aria-label="Hesap menüsü">
      <span class="menu-hap"><%- include("ikon", { ad: o.ikon, boyut: 24 }) %></span>
      <span class="menu-etiket"><%= o.ad %></span>
    </button>
    <% continue; } %>
    <a class="menu-ogesi<%= aktifMenu_ === o.id ? ' aktif' : '' %>" href="<%= o.href %>"<%- o.arama ? ' data-arama-ac' : '' %><%- aktifMenu_ === o.id ? ' aria-current="page"' : '' %>>
      <span class="menu-hap">
        <%- include("ikon", { ad: o.ikon, boyut: 24 }) %>
        <% if (o.id === "sohbet" && locals.okunmamisOda) { %><span class="menu-nokta" role="img" aria-label="Okunmamış oda mesajı var"></span><% } %>
        <% if (o.nokta) { %><span class="menu-nokta" role="img" aria-label="Okunmamış bildirim var"></span><% } %>
      </span>
      <span class="menu-etiket"><%= o.ad %></span>
    </a>
  <% } %>
</nav>
