  <link rel="stylesheet" href="/css/quadran.css">
  <link rel="stylesheet" href="/css/katmanlar.css">
  <link rel="stylesheet" href="/css/sayfalar.css">
  <link rel="stylesheet" href="/css/yonetim.css">
  <link rel="stylesheet" href="/css/efektler.css">
  <link rel="stylesheet" href="/css/hareket.css">
