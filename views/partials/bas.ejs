<!doctype html>
<html lang="tr" data-tema="<%= locals.tema || 'koyu' %>" data-vurgu="<%= locals.vurgu || 'safir' %>" data-menu="<%= locals.menuYonu || 'sol' %>"<%- locals.kompakt ? ' data-kompakt' : '' %><%- locals.azAnimasyon ? ' data-az-animasyon' : '' %>>
