<%#
  Beklenen veriler:
  konu      { id, title, kategori, created_at, duzenlendi (bool), yazar, rutbe, puan, konu_sayisi }
  mesajlar  [ { id, content, yazar, rutbe, created_at, deleted_at, skor, benim_oyum, konu_sahibi } ]
            İlk eleman konunun kendi metnidir (posts tablosundaki ilk mesaj).
  benzerler [ { id, title, skor } ]   aynı kategoriden başka konular
%>
<%- include("partials/bas", { baslik: konu.title }) %>
<%- include("partials/ust-cubuk") %>
<% const ilk = mesajlar[0]; const yorumlar = mesajlar.slice(1); %>
<div class="govde-iki">
  <main class="sutun-genis">
    <article class="kart konu"<%- ilk ? " id=\"mesaj-" + ilk.id + "\"" : "" %>>
      <div class="satir kucuk">
        <span class="etiket"><%= konu.kategori %></span>
        <% if (konu.cozuldu) { %><span class="cozum-cip"><%- include("partials/ikon", { ad: "onay", boyut: 13 }) %>Çözüldü</span><% } %>
        <span class="ikincil"><%= zaman(konu.created_at) %><%= konu.duzenlendi ? " · düzenlendi" : "" %></span>
      </div>
      <h1><%= konu.title %></h1>
      <div class="yazar-satiri">
        <span class="avatar avatar-36"><%= konu.yazar[0] %></span>
        <a class="kullanici" href="/profil/<%= konu.yazar %>"><%= konu.yazar %></a>
        <% if (konu.rutbe) { %><%- include("partials/rutbe", { rutbeAd: konu.rutbe, rutbeId: konu.rutbe_id }) %><% } %>
      </div>
      <% if (ilk) { %>
        <div class="metin"><%- icerikHtml(ilk.content, ilk.rutbe_id, ilk.yazar_rol) %></div>
        <%- include("partials/imza", { yazar: ilk }) %>
        <div class="eylem-satiri">
          <div class="oy-yatay"><%- include("partials/oy", { hedef: ilk }) %></div>
          <a class="eylem" href="#yorumlar"><%- include("partials/ikon", { ad: "yorum", boyut: 18 }) %> <%= yorumlar.length %> yorum</a>
          <a class="eylem" href="/konu/<%= konu.id %>" data-paylas data-baslik="<%= konu.title %>"><%- include("partials/ikon", { ad: "paylas", boyut: 18 }) %> Paylaş</a>
          <span class="bosluk"></span>
          <% if (locals.kullanici && kullanici.id === ilk.user_id) { %>
            <a class="eylem" href="/mesaj/<%= ilk.id %>/duzenle"><%- include("partials/ikon", { ad: "kalem", boyut: 18 }) %> Düzenle</a>
            <form method="post" action="/mesaj/<%= ilk.id %>/sil" onsubmit="return confirm('Konu ve bütün cevapları silinsin mi? Bu geri alınamaz.')"><input type="hidden" name="_csrf" value="<%= locals.csrf %>">
              <button class="eylem"><%- include("partials/ikon", { ad: "cop", boyut: 18 }) %> Sil</button>
            </form>
          <% } else { %>
          <a class="eylem" href="/sikayet?post_id=<%= ilk.id %>" data-sikayet-ac data-post-id="<%= ilk.id %>" data-yazar="<%= ilk.yazar %>"><%- include("partials/ikon", { ad: "bayrak", boyut: 18 }) %> Şikâyet et</a>
          <% } %>
          <% if (["moderator", "admin"].includes(locals.kullanici?.rol)) { %>
            <button class="ikon-dugme moderasyon-dugmesi" type="button" popovertarget="moderasyon-menusu-<%= ilk.id %>" data-menu-ac aria-label="Moderasyon işlemleri"><%- include("partials/ikon", { ad: "daha", boyut: 20 }) %></button>
            <%- include("partials/moderasyon-menusu", { post_id: ilk.id, topic_id: konu.id }) %>
          <% } %>
        </div>
      <% } %>
    </article>

    <% if (konu.kilitli) { %>
      <div class="kart cevap-kutusu kilitli" id="cevap">
        <%- include("partials/ikon", { ad: "kilit", boyut: 16 }) %> Bu konu kilitli, yeni cevap yazılamaz.
      </div>
    <% } else if (locals.kullanici) { %>
      <form class="kart cevap-kutusu" id="cevap" method="post" action="/konu/<%= konu.id %>/cevap"><input type="hidden" name="_csrf" value="<%= locals.csrf %>">
        <div class="ust">
          <span class="avatar avatar-36"><%= kullanici.username[0] %></span>
          <textarea name="content" placeholder="Cevabını yaz" required maxlength="10000" aria-label="Cevabın"></textarea>
        </div>
        <div class="satir">
          <span class="ikincil kucuk bosluk">Saygılı ol, konuya katkı sağla.</span>
          <button class="buton buton-birincil">Cevapla</button>
        </div>
      </form>
    <% } else { %>
      <a class="kart cevap-kutusu kilitli" id="cevap" href="/giris?don=/konu/<%= konu.id %>">
        <%- include("partials/ikon", { ad: "kilit", boyut: 16 }) %> Cevap yazmak için giriş yap
      </a>
    <% } %>

    <div class="yorum-basligi" id="yorumlar">
      <h2><%= yorumlar.length %> yorum</h2>
      <div class="siralama">
        <a class="<%= locals.sirala !== 'yeni' ? 'aktif' : '' %>" href="?sirala=eniyi">En iyi</a>
        <a class="<%= locals.sirala === 'yeni' ? 'aktif' : '' %>" href="?sirala=yeni">Yeni</a>
      </div>
    </div>
    <% if (yorumlar.length === 0) { %>
      <div class="kart bos">Henüz yorum yok. İlk cevabı sen yaz.</div>
    <% } %>
    <% for (const mesaj of yorumlar) { %>
      <%- include("partials/yorum", { mesaj }) %>
    <% } %>
  </main>

  <aside class="sutun sag-panel">
    <section class="kart panel panel-20">
      <div class="satir">
        <span class="avatar avatar-48"><%= konu.yazar[0] %></span>
        <div>
          <div class="satir"><strong><%= konu.yazar %></strong><% if (konu.rutbe) { %><%- include("partials/rutbe", { rutbeAd: konu.rutbe, rutbeId: konu.rutbe_id }) %><% } %></div>
          <div class="ikincil kucuk"><%= konu.puan ?? 0 %> puan · <%= konu.konu_sayisi ?? 0 %> konu</div>
        </div>
      </div>
      <div class="satir">
        <a class="buton buton-tonal bosluk" href="/mesajlar/<%= konu.yazar %>">Mesaj gönder</a>
        <a class="buton buton-cerceveli" href="/profil/<%= konu.yazar %>">Profil</a>
      </div>
    </section>
    <% if (benzerler.length) { %>
      <section class="kart panel panel-20 yan-liste">
        <h3><%= konu.kategori %> kategorisinden</h3>
        <% for (const b of benzerler) { %>
          <a href="/konu/<%= b.id %>"><span class="sayi"><%= b.skor ?? 0 %></span><span><%= b.title %></span></a>
        <% } %>
      </section>
    <% } %>
  </aside>
</div>
<%# Misafir şikâyet edemez: pencere yoksa "Şikâyet et" bağlantısı /sikayet üzerinden girişe götürür (ayrıca misafir sayfasında oturum açılmaz) %>
<% if (locals.kullanici) { %><%- include("partials/sikayet-penceresi") %><% } %>
<%- include("partials/son") %>
