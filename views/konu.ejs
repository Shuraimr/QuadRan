<%#
  Beklenen veriler:
  konu      { id, title, kategori, created_at, duzenlendi (bool), yazar, rutbe, puan, konu_sayisi }
  mesajlar  [ { id, content, yazar, rutbe, created_at, deleted_at, skor, benim_oyum, konu_sahibi } ]
            İlk eleman konunun kendi metnidir (posts tablosundaki ilk mesaj).
  benzerler [ { id, title, skor } ]   aynı kategoriden başka konular
%>
<%- include("partials/bas", { baslik: konu.title }) %>
<%- include("partials/ust-cubuk") %>
<% const ilk = mesajlar[0]; const yorumlar = mesajlar.slice(1); %>
<div class="govde-iki">
  <main class="sutun-genis">
    <article class="kart konu"<%- ilk ? " id=\"mesaj-" + ilk.id + "\"" : "" %>>
      <div class="satir kucuk">
        <span class="etiket"><%= konu.kategori %></span>
        <% if (konu.cozuldu) { %><span class="cozum-cip"><%- include("partials/ikon", { ad: "onay", boyut: 13 }) %>Çözüldü</span><% } %>
        <span class="ikincil"><%= zaman(konu.created_at) %><%= konu.duzenlendi ? " · düzenlendi" : "" %></span>
      </div>
      <h1><%= konu.title %></h1>
      <div class="yazar-satiri">
        <%- include("partials/avatar", { ad: konu.yazar, url: konu.avatar_url, sus: konu.avatar_susu, sinif: "avatar-36", bos: true }) %>
        <a class="kullanici" href="/profil/<%= konu.yazar %>"><%= konu.yazar %></a>
        <% if (konu.rutbe) { %><%- include("partials/rutbe", { rutbeAd: konu.rutbe, rutbeId: konu.rutbe_id }) %><% } %>
        <%- include("partials/unvan", { unvan: konu.unvan, premium: konu.premium }) %>
      </div>
      <% if (ilk) { %>
        <div class="metin"><%- icerikHtml(ilk.content, ilk.rutbe_id, ilk.yazar_rol) %></div>
        <%- include("partials/kartlar", { mesaj: ilk }) %>
        <%- include("partials/imza", { yazar: ilk }) %>
        <div class="eylem-satiri">
          <div class="oy-yatay"><%- include("partials/oy", { hedef: ilk }) %></div>
          <a class="eylem" href="#yorumlar"><%- include("partials/ikon", { ad: "yorum", boyut: 18 }) %> <%= yorumlar.length %> yorum</a>
          <a class="eylem" href="/konu/<%= konu.id %>" data-paylas data-baslik="<%= konu.title %>"><%- include("partials/ikon", { ad: "paylas", boyut: 18 }) %> Paylaş</a>
          <span class="bosluk"></span>
          <% if (locals.kullanici && kullanici.id === ilk.user_id) { %>
            <a class="eylem" href="/mesaj/<%= ilk.id %>/duzenle"><%- include("partials/ikon", { ad: "kalem", boyut: 18 }) %> Düzenle</a>
            <form method="post" action="/mesaj/<%= ilk.id %>/sil" data-onay="Konu ve bütün cevapları silinsin mi? Bu geri alınamaz."><input type="hidden" name="_csrf" value="<%= locals.csrf %>">
              <button class="eylem"><%- include("partials/ikon", { ad: "cop", boyut: 18 }) %> Sil</button>
            </form>
          <% } else { %>
          <a class="eylem" href="/sikayet?post_id=<%= ilk.id %>" data-sikayet-ac data-post-id="<%= ilk.id %>" data-yazar="<%= ilk.yazar %>"><%- include("partials/ikon", { ad: "bayrak", boyut: 18 }) %> Şikâyet et</a>
          <% } %>
          <%# Konu sahibinin ⋮ menüsü: profile sabitle / kaldır. Sahip aynı zamanda yetkiliyse tek ⋮ yeter: öğeler moderasyon menüsünün başına eklenir. %>
          <% const sahibi_ = locals.kullanici && kullanici.id === konu.user_id; const yetkili_ = ["moderator", "admin"].includes(locals.kullanici?.rol); %>
          <% if (sahibi_ && !yetkili_) { %>
            <button class="ikon-dugme moderasyon-dugmesi" type="button" popovertarget="konu-menusu" data-menu-ac aria-label="Konu işlemleri"><%- include("partials/ikon", { ad: "daha", boyut: 20 }) %></button>
            <div class="acilir-menu acilir-menu-konumlu" id="konu-menusu" popover aria-label="Konu işlemleri">
              <%- include("partials/profil-sabit-oge") %>
            </div>
          <% } %>
          <% if (yetkili_) { %>
            <button class="ikon-dugme moderasyon-dugmesi" type="button" popovertarget="moderasyon-menusu-<%= ilk.id %>" data-menu-ac aria-label="Moderasyon işlemleri"><%- include("partials/ikon", { ad: "daha", boyut: 20 }) %></button>
            <%- include("partials/moderasyon-menusu", { post_id: ilk.id, yazar_id: ilk.user_id, topic_id: konu.id, sahibi: sahibi_ }) %>
          <% } %>
        </div>
      <% } %>
    </article>

    <% if (konu.kilitli) { %>
      <div class="kart cevap-kutusu kilitli" id="cevap">
        <%- include("partials/ikon", { ad: "kilit", boyut: 16 }) %> Bu konu kilitli, yeni cevap yazılamaz.
      </div>
    <% } else if (locals.kullanici) { %>
      <%# Cevap formu (Figma 15): metin + araç satırı (fotoğraf, video) + seçilen eklerin önizleme kareleri + bağlantı çipi + +18 kutusu.
          multipart: JS'siz de olduğu gibi gönderilir; quadran.js varsa XHR ile gönderir (kare başına ilerleme). _csrf İLK alan olmalı (src/ekler.ts). %>
      <% const ey_ = locals.ekYetki || { gorsel: { acik: false }, video: { acik: false }, baglanti: false }; const tas_ = locals.taslak || {}; %>
      <form class="kart cevap-kutusu" id="cevap" method="post" action="/konu/<%= konu.id %>/cevap" enctype="multipart/form-data" data-ek-form data-baglanti="<%= ey_.baglanti ? '1' : '0' %>"><input type="hidden" name="_csrf" value="<%= locals.csrf %>">
        <div class="ust">
          <%- include("partials/avatar", { ad: kullanici.username, url: kullanici.avatar_url, sus: kullanici.avatar_susu, sinif: "avatar-36", bos: true }) %>
          <textarea name="content" placeholder="Cevabını yaz" maxlength="10000" aria-label="Cevabın" data-ek-metin><%= tas_.content || "" %></textarea>
        </div>
        <div class="ek-onizleme" data-ek-onizleme hidden></div>
        <div class="ek-baglanti-cip" data-ek-baglanti-cip hidden><span class="ek-cip-ikon" data-cip-ikon></span><span class="ek-cip-metin" data-cip-metin></span><button class="ek-cip-kapat" type="button" data-cip-kapat aria-label="Bağlantı önizlemesini kaldır">×</button></div>
        <input type="hidden" name="kart_kapali" value="<%= tas_.kartKapali ? '1' : '' %>" data-kart-kapali>
        <label class="ek-nsfw-satir" data-ek-nsfw><input type="checkbox" name="nsfw" value="1" <%= tas_.nsfw ? "checked" : "" %>><span>Eklerim +18 içerik</span></label>
        <div class="ek-arac">
          <% if (ey_.gorsel.acik) { %>
            <label class="ek-dugme" title="Fotoğraf ekle"><%- include("partials/ikon", { ad: "resim", boyut: 20 }) %><span class="arama-gizli-baslik">Fotoğraf ekle</span>
              <input type="file" class="gorunmez" name="resimler" accept="image/jpeg,image/png,image/webp,image/gif" multiple data-ek-resim aria-label="Fotoğraf ekle (en fazla 6)"></label>
          <% } %>
          <% if (ey_.video.acik) { %>
            <label class="ek-dugme" title="Video ekle"><%- include("partials/ikon", { ad: "video", boyut: 20 }) %><span class="arama-gizli-baslik">Video ekle</span>
              <input type="file" class="gorunmez" name="video" accept="video/mp4,video/webm" data-ek-video aria-label="Video ekle (en fazla 50 MB)"></label>
          <% } %>
          <span class="ikincil kucuk bosluk ek-ipucu">Saygılı ol, konuya katkı sağla.</span>
          <button class="buton buton-birincil" data-ek-gonder>Gönder</button>
        </div>
        <% if (!ey_.gorsel.acik || !ey_.video.acik) { %>
          <div class="ek-kilitler">
            <% if (!ey_.gorsel.acik) { %><%- include("partials/kilit", { kilit: ey_.gorsel, ek: "Yorumlarına en fazla 6 fotoğraf ekleyebilirsin." }) %><% } %>
            <% if (!ey_.video.acik) { %><%- include("partials/kilit", { kilit: ey_.video, ek: "Yorumlarına 50 MB’a kadar video ekleyebilirsin." }) %><% } %>
          </div>
        <% } %>
        <div class="ek-hata bilgi-notu hata-notu" role="alert" data-ek-hata hidden></div>
      </form>
    <% } else { %>
      <a class="kart cevap-kutusu kilitli" id="cevap" href="/giris?don=/konu/<%= konu.id %>">
        <%- include("partials/ikon", { ad: "kilit", boyut: 16 }) %> Cevap yazmak için giriş yap
      </a>
    <% } %>

    <div class="yorum-basligi" id="yorumlar">
      <h2><%= yorumlar.length %> yorum</h2>
      <div class="siralama">
        <a class="<%= locals.sirala !== 'yeni' ? 'aktif' : '' %>" href="?sirala=eniyi">En iyi</a>
        <a class="<%= locals.sirala === 'yeni' ? 'aktif' : '' %>" href="?sirala=yeni">Yeni</a>
      </div>
    </div>
    <% if (yorumlar.length === 0) { %>
      <div class="kart bos">Henüz yorum yok. İlk cevabı sen yaz.</div>
    <% } %>
    <% for (const mesaj of yorumlar) { %>
      <%- include("partials/yorum", { mesaj }) %>
    <% } %>
  </main>

  <aside class="sutun sag-panel">
    <section class="kart panel panel-20">
      <div class="satir">
        <%- include("partials/avatar", { ad: konu.yazar, url: konu.avatar_url, sus: konu.avatar_susu, sinif: "avatar-48", bos: true }) %>
        <div>
          <div class="satir"><strong><%= konu.yazar %></strong><% if (konu.rutbe) { %><%- include("partials/rutbe", { rutbeAd: konu.rutbe, rutbeId: konu.rutbe_id }) %><% } %></div>
          <div class="ikincil kucuk"><%= konu.puan ?? 0 %> puan · <%= konu.konu_sayisi ?? 0 %> konu</div>
        </div>
      </div>
      <div class="satir">
        <a class="buton buton-tonal bosluk" href="/mesajlar/<%= konu.yazar %>">Mesaj gönder</a>
        <a class="buton buton-cerceveli" href="/profil/<%= konu.yazar %>">Profil</a>
      </div>
    </section>
    <% if (benzerler.length) { %>
      <section class="kart panel panel-20 yan-liste">
        <h3><%= konu.kategori %> kategorisinden</h3>
        <% for (const b of benzerler) { %>
          <a href="/konu/<%= b.id %>"><span class="sayi"><%= b.skor ?? 0 %></span><span><%= b.title %></span></a>
        <% } %>
      </section>
    <% } %>
  </aside>
</div>
<%# Misafir şikâyet edemez: pencere yoksa "Şikâyet et" bağlantısı /sikayet üzerinden girişe götürür (ayrıca misafir sayfasında oturum açılmaz) %>
<% if (locals.kullanici) { %><%- include("partials/sikayet-penceresi") %><% } %>
<%- include("partials/son") %>
