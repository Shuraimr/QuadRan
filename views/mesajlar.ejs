<%# Private messages: /mesajlar and /mesajlar/:kullanici
   Expected data:
   q           string (optional)  username searched in the conversation list (GET /mesajlar?q=)
   konusmalar  [ { kullanici, rutbe, son_mesaj, son_zaman (Date), okunmamis (number), son_benden (bool, optional) } ]
               grouped by the other person from the messages table; newest first by son_zaman
   acik        null or { kullanici, rutbe, mesajlar: [ { id, benim (bool: sender_id is the signed-in person), content, created_at, read_at } ] }
               (mesajlar[].silindi: true if a moderator removed it, an info text comes instead of content)
               mesajlar is ordered oldest to newest. If null the "Pick a conversation" empty state shows
   acik.cevrimici (bool: seen within the last 5 min AND not hiding their status), acik.durum ("izinli" | "ben_engelledim" | "kapali")
   yeni        if true the "New message" search shows on the right (no-JS path: GET /mesajlar/yeni?q=); aramaQ, sonuclar [ { username, rutbe } ]
   Send: POST /mesajlar/<kullanici>  field: content · Delete: POST /mesajlar/mesaj/<id>/sil · Block: POST /engel/<kullanici>[/kaldir] %>
<%#
  Özel mesajlar: /mesajlar ve /mesajlar/:kullanici
  Beklenen veriler:
  q           string (isteğe bağlı)  konuşma listesinde aranan kullanıcı adı (GET /mesajlar?q=)
  konusmalar  [ { kullanici, rutbe, son_mesaj, son_zaman (Date), okunmamis (sayı), son_benden (bool, isteğe bağlı) } ]
              messages tablosundan karşıdaki kişiye göre gruplanır; son_zaman'a göre yeniden eskiye
  acik        null ya da { kullanici, rutbe, mesajlar: [ { id, benim (bool: sender_id giriş yapan kişi), content, created_at, read_at } ] }
              (mesajlar[].silindi: moderatör kaldırdıysa true, content yerine bilgi metni gelir)
              mesajlar eskiden yeniye sıralı. null ise "Bir konuşma seç" boş durumu görünür
  acik.cevrimici (bool: son 5 dk içinde görüldü VE durumunu gizlemiyor), acik.durum ("izinli" | "ben_engelledim" | "kapali")
  yeni        true ise sağ tarafta "Yeni mesaj" araması (JS'siz yol: GET /mesajlar/yeni?q=); aramaQ, sonuclar [ { username, rutbe } ]
  Gönderim: POST /mesajlar/<kullanici>  alan: content · Sil: POST /mesajlar/mesaj/<id>/sil · Engel: POST /engel/<kullanici>[/kaldir]
%>
<%- include("partials/bas", { baslik: "Sohbet · DM" }) %>
<%- include("partials/ust-cubuk") %>
<%
  const mjAcik = locals.acik || null;
  const mjListe = locals.konusmalar || [];
  const mjQ = locals.q || "";
  const mjGunBasi = (d) => { const x = new Date(d); x.setHours(0, 0, 0, 0); return x.getTime(); };
  const mjFark = (d) => Math.round((mjGunBasi(new Date()) - mjGunBasi(d)) / 86400000);
  const mjSaat = (d) => new Date(d).toLocaleTimeString("tr-TR", { hour: "2-digit", minute: "2-digit" });
  const mjGunEtiketi = (d) => {
    const f = mjFark(d);
    if (f === 0) return "Bugün";
    if (f === 1) return "Dün";
    return new Date(d).toLocaleDateString("tr-TR", { day: "numeric", month: "long", year: f > 300 ? "numeric" : undefined });
  };
  const mjListeZaman = (d) => {
    const f = mjFark(d);
    if (f === 0) return mjSaat(d);
    if (f === 1) return "Dün";
    return new Date(d).toLocaleDateString("tr-TR", { day: "numeric", month: "short" });
  };

  // Split messages into days and consecutive groups (same person, same day, less than 10 minutes apart)
  // Mesajları günlere ve art arda gelen gruplara ayır (aynı kişi, aynı gün, aralarında 10 dakikadan az)
  const mjOgeler = [];
  let mjSonBenim = null;
  if (mjAcik) {
    let sonGun = null, sonGrup = null, sonZaman = 0;
    for (const m of mjAcik.mesajlar) {
      const gun = mjGunBasi(m.created_at);
      const t = new Date(m.created_at).getTime();
      if (gun !== sonGun) { mjOgeler.push({ tur: "gun", etiket: mjGunEtiketi(m.created_at) }); sonGun = gun; sonGrup = null; }
      if (!sonGrup || sonGrup.benim !== !!m.benim || t - sonZaman > 10 * 60 * 1000) {
        sonGrup = { tur: "grup", benim: !!m.benim, mesajlar: [], goruldu: null };
        mjOgeler.push(sonGrup);
      }
      sonGrup.mesajlar.push(m);
      sonZaman = t;
      if (m.benim) mjSonBenim = { grup: sonGrup, mesaj: m };
    }
    // The "Seen" note only shows under my last message
    // "Görüldü" notu yalnızca benim son mesajımın altında görünür
    if (mjSonBenim && mjSonBenim.mesaj.read_at) mjSonBenim.grup.goruldu = mjSonBenim.mesaj.read_at;
  }
%>
<main class="mesaj-sayfa <%= mjAcik || locals.yeni ? 'mesaj-acik' : '' %>">
  <section class="kart mesaj-liste" aria-label="Konuşmalar">
    <div class="mesaj-liste-ust">
      <div class="mesaj-liste-baslik">
        <h1>Sohbet</h1>
        <%# "New message" is hidden only on the new-message page: the same search is already open there, so the same action does not appear in two places %>
        <%# "Yeni mesaj" yalnızca yeni mesaj sayfasında yok: orada zaten aynı arama açık, aynı eylem iki yerde durmasın %>
        <% if (!locals.yeni) { %><a class="buton buton-tonal yeni-mesaj-dugme" href="/mesajlar/yeni" data-yeni-mesaj-ac><%- include("partials/ikon", { ad: "kalem", boyut: 18 }) %> Yeni mesaj</a><% } %>
      </div>
      <%- include("partials/sohbet-filtre", { secili: "dm" }) %>
      <form class="mesaj-ara" method="get" action="/mesajlar" role="search">
        <%- include("partials/ikon", { ad: "ara", boyut: 18 }) %>
        <input type="search" name="q" value="<%= mjQ %>" placeholder="Konuşmalarda ara" aria-label="Konuşmalarda ara">
      </form>
    </div>
    <% if (mjListe.length === 0) { %>
      <%- include("partials/bos-durum", mjQ
        ? { ikon: "ara", baslik: "“" + mjQ + "” ile eşleşen konuşma yok", dar: true }
        : { ikon: "mektup", baslik: "Henüz mesajın yok", metin: "“Yeni mesaj” ile ya da bir kullanıcının profilinden konuşma başlatabilirsin.", dar: true }) %>
    <% } else { %>
      <nav class="mesaj-satirlar">
        <% for (const k of mjListe) { %>
          <% const aktif = mjAcik && mjAcik.kullanici === k.kullanici; %>
          <a class="mesaj-satir <%= aktif ? 'aktif' : '' %> <%= k.okunmamis > 0 ? 'okunmamis' : '' %>" href="/mesajlar/<%= k.kullanici %>" <% if (aktif) { %>aria-current="page"<% } %>>
            <%- include("partials/avatar", { ad: k.kullanici, url: k.avatar_url, sus: k.avatar_susu, sinif: "avatar-48", bos: true }) %>
            <span class="mesaj-satir-govde">
              <span class="mesaj-satir-ust">
                <strong><%= k.kullanici %></strong>
                <span class="kucuk ikincil"><%= mjListeZaman(k.son_zaman) %></span>
              </span>
              <span class="mesaj-satir-alt">
                <span class="mesaj-onizleme ikincil"><%= k.son_benden ? "Sen: " : "" %><%= k.son_mesaj %></span>
                <% if (k.okunmamis > 0) { %><span class="mesaj-rozet" role="img" aria-label="<%= k.okunmamis %> okunmamış mesaj"><%= k.okunmamis %></span><% } %>
              </span>
            </span>
          </a>
        <% } %>
      </nav>
    <% } %>
  </section>

  <section class="kart mesaj-pano" aria-label="Konuşma">
    <% if (locals.yeni) { %>
      <header class="mesaj-ust">
        <a class="ikon-dugme mesaj-geri" href="/mesajlar" aria-label="Konuşma listesine dön"><%- include("partials/ikon", { ad: "cevap", boyut: 20 }) %></a>
        <h2 class="mesaj-yeni-baslik">Yeni mesaj</h2>
      </header>
      <div class="mesaj-yeni"><%- include("partials/kisi-ara", { dialog: false, aramaQ: locals.aramaQ, sonuclar: locals.sonuclar }) %></div>
    <% } else if (!mjAcik) { %>
      <div class="mesaj-bos">
        <span class="mesaj-bos-ikon"><%- include("partials/ikon", { ad: "mektup", boyut: 28 }) %></span>
        <h2>Bir konuşma seç</h2>
        <p>Soldaki listeden bir konuşma aç ya da yeni bir mesaj başlat.</p>
      </div>
    <% } else { %>
      <header class="mesaj-ust">
        <a class="ikon-dugme mesaj-geri" href="/mesajlar" aria-label="Konuşma listesine dön"><%- include("partials/ikon", { ad: "cevap", boyut: 20 }) %></a>
        <%# The ONLY link to the profile: avatar and name together; the status line is inside the link too, no second link %>
        <%# Profile giden TEK bağlantı: avatar ve ad birlikte; durum satırı da bağlantının içinde, ikinci bağlantı yok %>
        <a class="mesaj-ust-kimlik" href="/profil/<%= mjAcik.kullanici %>">
          <%- include("partials/avatar", { ad: mjAcik.kullanici, url: mjAcik.avatar_url, sus: mjAcik.avatar_susu, sinif: "avatar-48", bos: true }) %>
          <span class="mesaj-ust-bilgi">
            <strong><%= mjAcik.kullanici %></strong>
            <% if (mjAcik.cevrimici) { %>
              <span class="mesaj-durum cevrimici"><span class="sohbet-nokta" aria-hidden="true"></span>Çevrimiçi</span>
            <% } else if (mjAcik.rutbe) { %>
              <span><%- include("partials/rutbe", { rutbeAd: mjAcik.rutbe, rutbeId: mjAcik.rutbe_id }) %></span>
            <% } %>
          </span>
        </a>
        <button class="ikon-dugme mesaj-ust-menu-dugme" type="button" popovertarget="mesaj-ust-menusu" data-menu-ac aria-label="Konuşma işlemleri"><%- include("partials/ikon", { ad: "daha", boyut: 20 }) %></button>
        <div class="acilir-menu acilir-menu-konumlu" id="mesaj-ust-menusu" popover aria-label="Konuşma işlemleri">
          <%# "Unblock" lives only in the card below (the same action must not appear in two places); in the menu, blocking is offered only if you have not blocked them %>
          <%# "Engeli kaldır" yalnızca aşağıdaki kartta durur (aynı eylem iki yerde çıkmasın); menüde engellemek yalnızca engelli değilsen var %>
          <% if (mjAcik.durum !== "ben_engelledim") { %>
            <form method="post" action="/engel/<%= encodeURIComponent(mjAcik.kullanici) %>"><input type="hidden" name="_csrf" value="<%= locals.csrf %>">
              <button class="acilir-oge acilir-oge-tehlikeli" type="submit"><%- include("partials/ikon", { ad: "yasak", boyut: 20 }) %><span class="acilir-ad"><%= belirtme(mjAcik.kullanici) %> engelle</span></button>
            </form>
          <% } %>
          <a class="acilir-oge acilir-oge-tehlikeli" href="/sikayet?kullanici=<%= encodeURIComponent(mjAcik.kullanici) %>" data-sikayet-ac data-kullanici="<%= mjAcik.kullanici %>" data-yazar="<%= mjAcik.kullanici %>"><%- include("partials/ikon", { ad: "bayrak", boyut: 20 }) %><span class="acilir-ad">Kullanıcıyı şikâyet et</span></a>
        </div>
      </header>
      <div class="mesaj-akis" tabindex="0" aria-label="Mesaj geçmişi">
        <div class="mesaj-akis-ic">
          <% if (mjOgeler.length === 0) { %>
            <div class="bos">Henüz mesaj yok. <%= mjAcik.durum === "izinli" ? "İlk mesajı sen yaz." : "" %></div>
          <% } %>
          <% for (const o of mjOgeler) { %>
            <% if (o.tur === "gun") { %>
              <div class="mesaj-gun"><%= o.etiket %></div>
            <% } else { %>
              <% const son = o.mesajlar[o.mesajlar.length - 1]; %>
              <div class="mesaj-grup <%= o.benim ? 'ben' : '' %>">
                <% for (const m of o.mesajlar) { %>
                  <div class="mesaj-satiri" id="m-<%= m.id %>">
                    <% if (m.silindi) { %>
                      <div class="mesaj-balon silindi"><%= o.benim ? "Bu mesajı sildin" : "Bu mesaj silindi" %></div>
                    <% } else { %>
                      <div class="mesaj-balon" id="mt-<%= m.id %>"><%- icerikHtml(m.content, o.benim ? locals.kullanici.rutbe_id : mjAcik.rutbe_id, o.benim ? locals.kullanici.rol : mjAcik.yazar_rol) %></div>
                      <button class="mesaj-menu-dugme" type="button" popovertarget="mesaj-menusu-<%= m.id %>" data-menu-ac aria-label="Mesaj işlemleri"><%- include("partials/ikon", { ad: "daha", boyut: 18 }) %></button>
                      <div class="acilir-menu acilir-menu-konumlu mesaj-menusu" id="mesaj-menusu-<%= m.id %>" popover aria-label="Mesaj işlemleri">
                        <%# Copy only works with JS; without JS the CSS hides it (invisible if the .js class is missing) %>
                        <%# Kopyala yalnızca JS'le çalışır; JS yokken CSS gizler (.js sınıfı yoksa görünmez) %>
                        <button class="acilir-oge mesaj-kopyala" type="button" data-kopyala="#mt-<%= m.id %>"><%- include("partials/ikon", { ad: "kopyala", boyut: 20 }) %><span class="acilir-ad">Kopyala</span></button>
                        <% if (o.benim) { %>
                          <form method="post" action="/mesajlar/mesaj/<%= m.id %>/sil" data-onay="Bu mesaj silinsin mi?"><input type="hidden" name="_csrf" value="<%= locals.csrf %>">
                            <button class="acilir-oge acilir-oge-tehlikeli" type="submit"><%- include("partials/ikon", { ad: "cop", boyut: 20 }) %><span class="acilir-ad">Sil</span></button>
                          </form>
                        <% } else { %>
                          <%# Only the RECIPIENT can report: it appears on incoming (not mine), non-deleted messages %>
                          <%# Yalnızca ALICI şikâyet edebilir: gelen (benim olmayan), silinmemiş mesajlarda çıkar %>
                          <a class="acilir-oge" href="/sikayet?mesaj_id=<%= m.id %>" data-sikayet-ac data-mesaj-id="<%= m.id %>" data-yazar="<%= mjAcik.kullanici %>" data-baslik="Bu özel mesajı şikâyet et"><%- include("partials/ikon", { ad: "bayrak", boyut: 20 }) %><span class="acilir-ad">Şikâyet et</span></a>
                        <% } %>
                      </div>
                    <% } %>
                  </div>
                <% } %>
                <div class="mesaj-alt-not">
                  <span><%= mjSaat(son.created_at) %></span>
                  <% if (o.goruldu) { %><span>· Görüldü <%= mjSaat(o.goruldu) %></span><% } %>
                </div>
              </div>
            <% } %>
          <% } %>
        </div>
      </div>
      <% if (mjAcik.durum === "izinli") { %>
        <form class="mesaj-yaz" method="post" action="/mesajlar/<%= mjAcik.kullanici %>"><input type="hidden" name="_csrf" value="<%= locals.csrf %>">
          <textarea name="content" rows="1" maxlength="2000" required placeholder="<%= mjAcik.kullanici %> kişisine mesaj yaz" aria-label="Mesajın"></textarea>
          <button class="buton buton-birincil">Gönder</button>
        </form>
      <% } else if (mjAcik.durum === "ben_engelledim") { %>
        <div class="mesaj-kilit">
          <span class="mesaj-bos-ikon"><%- include("partials/ikon", { ad: "yasak", boyut: 24 }) %></span>
          <strong><%= mjAcik.kullanici %> kullanıcısını engelledin</strong>
          <p>Sana mesaj gönderemez, sen de ona yazamazsın.</p>
          <form method="post" action="/engel/<%= encodeURIComponent(mjAcik.kullanici) %>/kaldir"><input type="hidden" name="_csrf" value="<%= locals.csrf %>">
            <button class="buton buton-cerceveli">Engeli kaldır</button>
          </form>
        </div>
      <% } else { %>
        <div class="mesaj-kilit">
          <span class="mesaj-bos-ikon"><%- include("partials/ikon", { ad: "kilit", boyut: 24 }) %></span>
          <strong>Bu kişiye şu an mesaj gönderemezsin.</strong>
        </div>
      <% } %>
    <% } %>
  </section>
</main>
<% if (mjAcik) { %><%- include("partials/sikayet-penceresi") %><% } %>
<% if (!locals.yeni) { %>
<dialog class="yeni-mesaj-penceresi" id="yeni-mesaj-penceresi" aria-labelledby="yeni-mesaj-baslik">
  <div class="yeni-mesaj-ic">
    <div class="yeni-mesaj-ust">
      <h2 id="yeni-mesaj-baslik">Yeni mesaj</h2>
      <button class="ikon-dugme" type="button" data-dialog-kapat aria-label="Kapat"><%- include("partials/ikon", { ad: "kapat", boyut: 20 }) %></button>
    </div>
    <%- include("partials/kisi-ara", { dialog: true, aramaQ: "", sonuclar: [] }) %>
  </div>
</dialog>
<% } %>
<%- include("partials/son") %>
