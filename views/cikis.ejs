<%#
  External link confirmation (the no-JS path; with JS rubyyard.js opens the same content in a window). Expected: hata (bool), adres (full address), alan (domain), geri (Cancel address).
  The domain is shown large (whose site you are going to is the key information); the full address stays below it, untruncated.
  Dış bağlantı onayı (JS'siz yol; JS varsa rubyyard.js aynı içeriği pencerede açar). Beklenen: hata (bool), adres (tam adres), alan (alan adı), geri (Vazgeç adresi).
  Alan adı büyük gösterilir (kimin sitesine gidildiği asıl bilgi), tam adres kırpılmadan altında durur.
%>
<%- include("partials/bas", { sade: true, baslik: "rubyyard'dan ayrılıyorsun" }) %>
<div class="orta-sayfa">
  <%- include("partials/kontur") %>
  <a class="logo" href="/"><span class="logo-isaret"><img src="/img/marka/rakun-96.webp" alt="" width="32" height="32"></span>rubyyard</a>
  <div class="kart form-karti cikis-karti">
    <% if (hata) { %>
      <h1>Bağlantı açılamadı</h1>
      <div class="bilgi-notu hata-notu" role="alert"><%- include("partials/ikon", { ad: "uyari", boyut: 18 }) %><span>Bu adres geçerli bir web adresi değil. Yalnızca http ve https adresleri açılır.</span></div>
      <a class="buton buton-tonal buton-genis" href="<%= geri %>">Geri dön</a>
    <% } else { %>
      <h1>rubyyard’dan ayrılıyorsun</h1>
      <div class="cikis-alan"><strong><%= alan %></strong><span><%= adres %></span></div>
      <div class="bilgi-notu cikis-uyari"><%- include("partials/ikon", { ad: "uyari", boyut: 18 }) %><span>Görünen yazı ile adres farklıysa dikkat et. Başka sitelerin içeriğinden rubyyard sorumlu değildir.</span></div>
      <div class="cikis-eylem">
        <a class="buton buton-cerceveli" href="<%= geri %>" data-geri>Vazgeç</a>
        <a class="buton buton-birincil" href="<%= adres %>" target="_blank" rel="nofollow ugc noopener noreferrer">Siteye git <%- include("partials/ikon", { ad: "dis", boyut: 16 }) %></a>
      </div>
    <% } %>
  </div>
</div>
<%- include("partials/son", { sade: true }) %>
