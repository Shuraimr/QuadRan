<%#
  General chat: /sohbet   (chat_messages table; no live updates, new messages arrive when the page is refreshed)
  Expected data:
  mesajlar    [ { id, yazar, rutbe, content, created_at } ]   sorted OLDEST TO NEWEST (like the last 50 messages);
              yazar = users.username (joined via chat_messages.user_id), rutbe is computed from points
  cevrimici   [ { username } ]   users active in the last few minutes (no counterpart in the table: needs
              session or last-seen information, optional for now)
  hata        string (optional)   e.g. "Mesaj boş olamaz."
  if locals.kullanici { username } exists, the writing box; otherwise a locked box and a /giris?don=/sohbet link
  Form: POST /sohbet  field: content
  Report: a flag button on every message by others (POST /sikayet, field sohbet_id); deleted messages are not in the list
  hub         chat hub data for members (partials/sohbet-liste.ejs); if missing (guest) the old layout: feed + Online/Rules side column
  genelAcik   (bool) whether the conversation view is open on phones (?genel=1); otherwise the list shows first on phones
  panelAcik   if "yeni", the "Create room" window opens (the no-JS /oda/yeni page)
  Genel sohbet: /sohbet   (chat_messages tablosu; canlı güncelleme yok, sayfa yenilenince yeni mesajlar gelir)
  Beklenen veriler:
  mesajlar    [ { id, yazar, rutbe, content, created_at } ]   ESKİDEN YENİYE sıralı (son 50 mesaj gibi);
              yazar = users.username (chat_messages.user_id ile birleştirilir), rutbe puandan hesaplanır
  cevrimici   [ { username } ]   son birkaç dakikada etkin kullanıcılar (tabloda karşılığı yok: oturum
              ya da son_gorulme bilgisi gerekir, şimdilik isteğe bağlı)
  hata        string (isteğe bağlı)   örn. "Mesaj boş olamaz."
  locals.kullanici { username } varsa yazma kutusu, yoksa kilitli kutu ve /giris?don=/sohbet bağlantısı
  Form: POST /sohbet  alan: content
  Şikâyet: başkasının her mesajında bayrak düğmesi (POST /sikayet, alan sohbet_id); silinmiş mesajlar listede yoktur
  hub         üyeler için sohbet merkezi verisi (partials/sohbet-liste.ejs); yoksa (misafir) eski düzen: akış + Çevrimiçi/Kurallar yan sütunu
  genelAcik   (bool) telefonda konuşma görünümü açık mı (?genel=1); yoksa telefonda önce liste çıkar
  panelAcik   "yeni" ise "Oda aç" penceresi açık gelir (JS'siz /oda/yeni sayfası)
%>
<%- include("partials/bas", { baslik: "Sohbet" }) %>
<%- include("partials/ust-cubuk") %>
<%
  const shMesajlar = locals.mesajlar || [];
  const shCevrimici = locals.cevrimici || [];
  const shKurallar = [
    "Birbirine saygılı ol, hakaret ve kışkırtma yok.",
    "Soru için konu aç, sohbet hızlı konuşmalar içindir.",
    "Spam, reklam ve kişisel bilgi paylaşımı yasak.",
    "Sorun görürsen bir moderatöre haber ver."
  ];
  // Group consecutive messages: the same person and less than 10 minutes apart
  // Art arda gelen mesajları grupla: aynı kişi ve aralarında 10 dakikadan az
  const shOgeler = [];
  let shSon = null;
  for (const m of shMesajlar) {
    const t = new Date(m.created_at).getTime();
    const devam = shSon && shSon.yazar === m.yazar && t - shSon.t < 10 * 60 * 1000;
    shOgeler.push({ m, devam: !!devam });
    shSon = { yazar: m.yazar, t };
  }
%>
<% if (locals.hub) { %>
<main class="mesaj-sayfa sohbet-merkez<%= locals.genelAcik ? ' mesaj-acik' : '' %>">
  <%- include("partials/sohbet-liste") %>
  <section class="kart mesaj-pano sohbet-pano" aria-label="Genel sohbet">
    <%- include("partials/genel-sohbet", { merkez_: true, shCevrimici, shOgeler, shKurallar }) %>
  </section>
</main>
<%- include("partials/oda-ac-penceresi") %>
<% } else { %>
<main class="sohbet-sayfa">
  <section class="kart sohbet-pano" aria-label="Genel sohbet">
    <%- include("partials/genel-sohbet", { merkez_: false, shCevrimici, shOgeler, shKurallar }) %>
  </section>

  <aside class="sohbet-yan">
    <section class="kart panel panel-20" aria-label="Çevrimiçi">
      <h3>Çevrimiçi</h3>
      <% if (shCevrimici.length === 0) { %>
        <p class="ikincil kucuk">Şu an kimse görünmüyor.</p>
      <% } else { %>
        <div class="sohbet-cevrimici">
          <% for (const c of shCevrimici) { %>
            <a href="/profil/<%= c.username %>"><span class="sohbet-nokta" aria-hidden="true"></span><%= c.username %></a>
          <% } %>
        </div>
      <% } %>
    </section>
    <section class="kart panel panel-20" aria-label="Sohbet kuralları">
      <h3>Kurallar</h3>
      <ol class="sohbet-kurallar">
        <% for (const k of shKurallar) { %><li><span><%= k %></span></li><% } %>
      </ol>
    </section>
  </aside>
</main>
<% } %>
<% if (locals.kullanici) { %><%- include("partials/sikayet-penceresi") %><% } %>
<%- include("partials/son") %>
