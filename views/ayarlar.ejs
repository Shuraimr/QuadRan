<%#
  Beklenen veriler:
  ayar  { username, bio, email, avatar_url, banner_url, profil_efekti, avatar_susu, profil_renk_ana, profil_renk_vurgu, profil_renk_gecis, premium_aktif, tema ("koyu"|"acik"|"sistem"), vurgu ("safir"|"zumrut"|"kehribar"|"ametist"|"yakut"),
          menu_sagda (bool), kompakt (bool), az_animasyon (bool) }
  ayar.konum, ayar.web_sitesi, ayar.dm_izni ("herkes"|"kimse"), ayar.cevrimici_goster (bool), ayar.engelliler [ { username } ]
  ayar.imza (string | null), imzaKilit { acik, ad, rutbe, kalan }   imza alanı yalnızca rütbe izin veriyorsa (kilitBilgisi)
  hatalar { username, bio, konum, web_sitesi, imza }   (isteğe bağlı)
  Formlar: POST /ayarlar/avatar|banner (multipart) · /ayarlar/avatar|banner/kaldir · /ayarlar/profil-gorunumu · POST /ayarlar/profil (username, bio, konum, web_sitesi, imza) · POST /ayarlar/gorunum · POST /ayarlar/gizlilik (dm_izni, cevrimici_goster)
           · POST /engel/<ad>/kaldir · POST /hesap/sil
%>
<%- include("partials/bas", { baslik: "Ayarlar" }) %>
<%- include("partials/ust-cubuk") %>
<% const h = locals.hatalar || {}; %>
<div class="ayarlar">
  <%# Bölüm gezintisi tek yerde durur (kalıcı arayüzde tekrar yok):
      masaüstü (>1180) sol kenar menüde Ayarlar'ın altındaki satırlar (partials/kenar-menu), buradaki liste gizli;
      tablet (801–1180) bu nav üst çubuğun altına yapışan şerittir (başlık + bölüm sekmeleri); telefon üstte yatay çipler. %>
  <div class="ayar-gezinti">
    <header class="ayar-baslik"><h1>Ayarlar</h1><p class="ikincil">Profilin, görünüm ve hesabınla ilgili her şey</p></header>
    <%# Masaüstünde bu nav gizlidir (bölümler kenar menüde); ekran okuyucu yalnızca bir "Ayarlar bölümleri" gezintisi duyar %>
    <nav class="kategoriler" aria-label="Ayarlar bölümleri">
      <a class="kategori-ogesi aktif" href="#profil" data-bolum-bag><%- include("partials/ikon", { ad: "kisi" }) %> Profil</a>
      <a class="kategori-ogesi" href="#profil-gorunumu" data-bolum-bag><%- include("partials/ikon", { ad: "yildiz" }) %> Profil görünümü</a>
      <a class="kategori-ogesi" href="#gorunum" data-bolum-bag><%- include("partials/ikon", { ad: "palet" }) %> Görünüm</a>
      <a class="kategori-ogesi" href="#gizlilik" data-bolum-bag><%- include("partials/ikon", { ad: "kilit" }) %> Gizlilik</a>
      <a class="kategori-ogesi" href="#hesap" data-bolum-bag><%- include("partials/ikon", { ad: "kalkan" }) %> Hesap ve güvenlik</a>
    </nav>
  </div>
  <div class="bolumler">
    <form class="kart bolum" id="profil" method="post" action="/ayarlar/profil"><input type="hidden" name="_csrf" value="<%= locals.csrf %>">
      <div><h2>Profil</h2><p class="ikincil kucuk">Herkese açık profilinde görünen bilgiler</p></div>
      <label class="alan <%= h.username ? 'hatali' : '' %>" style="margin-top: 8px"><span>Kullanıcı adı</span>
        <input name="username" value="<%= ayar.username %>" required minlength="3" maxlength="30" pattern="[A-Za-z0-9_]+">
      </label>
      <div class="yardim"><span><%= h.username || "Harf, rakam ve alt çizgi kullanılabilir" %></span></div>
      <label class="alan <%= h.bio ? 'hatali' : '' %>"><span>Hakkında</span>
        <textarea name="bio" maxlength="280" style="min-height: 104px"><%= ayar.bio || '' %></textarea>
      </label>
      <div class="yardim"><span><%= h.bio || "Profilinde görünür" %></span><span>en fazla 280</span></div>
      <%# Konum ve web sitesi kısa alanlar: geniş ekranda yan yana (telefonda alt alta) %>
      <div class="iki-alan"><div>
      <label class="alan <%= h.konum ? 'hatali' : '' %>"><span>Konum</span>
        <input name="konum" value="<%= ayar.konum || '' %>" maxlength="60" placeholder="Şehir, ülke">
      </label>
      <div class="yardim"><span><%= h.konum || "Profilinde görünür · en fazla 60 karakter" %></span></div>
      </div><div>
      <label class="alan <%= h.web_sitesi ? 'hatali' : '' %>"><span>Web sitesi</span>
        <input name="web_sitesi" type="url" value="<%= ayar.web_sitesi || '' %>" maxlength="200" placeholder="https://ornek.com" pattern="https?://.+">
      </label>
      <div class="yardim"><span><%= h.web_sitesi || "http:// ya da https:// ile başlamalı" %></span></div>
      </div></div>
      <%# İmza (rütbe ayrıcalığı): açıksa alan, kapalıysa kilit kartı (hangi rütbede açılacağı ve kalan puan) %>
      <% if (locals.imzaKilit && !imzaKilit.acik) { %>
        <%- include("partials/kilit", { kilit: imzaKilit }) %>
      <% } else { %>
        <label class="alan <%= h.imza ? 'hatali' : '' %>"><span>İmza</span>
          <input name="imza" value="<%= ayar.imza || '' %>" maxlength="120" placeholder="Mesajlarının altında görünür">
        </label>
        <div class="yardim"><span><%= h.imza || "Konu ve cevaplarının altında küçük yazıyla görünür" %></span><span>en fazla 120</span></div>
      <% } %>
      <div class="satir" style="justify-content: flex-end"><button class="buton buton-birincil">Kaydet</button></div>
    </form>

    <%# Vitrin: profilin üstünde öne çıkan rozetler (en çok 3) ve bir konu. Bölüm gezintisinde ayrı satırı yok: Profil bölümünün hemen altında durur. %>
    <form class="kart bolum" id="vitrin" method="post" action="/ayarlar/vitrin"><input type="hidden" name="_csrf" value="<%= locals.csrf %>">
      <div><h2>Vitrin</h2><p class="ikincil kucuk">Profilinin en üstünde öne çıkanlar</p></div>
      <div class="ust-etiket">ROZETLER · EN ÇOK 3</div>
      <% if ((ayar.rozetler || []).length === 0) { %>
        <p class="ikincil kucuk">Henüz rozetin yok. Kazandıkça burada seçebilirsin.</p>
      <% } else { %>
        <% for (const r of ayar.rozetler) { %>
          <label class="ayar-satiri anahtar">
            <div><strong><%= r.name %></strong><span class="ikincil kucuk"><%= r.description %></span></div>
            <input type="checkbox" name="rozet" value="<%= r.id %>" <%= r.vitrin_sira ? "checked" : "" %>><span class="ray"></span>
          </label>
        <% } %>
      <% } %>
      <label class="alan"><span>Sabitlenen konu</span>
        <select name="sabit_konu_id">
          <option value="">Yok</option>
          <% for (const t of (ayar.konular || [])) { %><option value="<%= t.id %>" <%= Number(ayar.sabit_konu_id) === t.id ? "selected" : "" %>><%= t.title %></option><% } %>
        </select>
      </label>
      <div class="yardim"><span>Konuyu konu sayfasındaki ⋮ menüsünden de sabitleyebilirsin · en yeni 50 konun listelenir</span></div>
      <div class="satir" style="justify-content: flex-end"><button class="buton buton-birincil">Kaydet</button></div>
    </form>

    <%- include("partials/profil-gorunumu-bolumu") %>

    <form class="kart bolum" id="gorunum" method="post" action="/ayarlar/gorunum"><input type="hidden" name="_csrf" value="<%= locals.csrf %>">
      <div><h2>Görünüm</h2><p class="ikincil kucuk">Hesabına kaydedilir, her cihazda aynı görünür</p></div>
      <div class="ust-etiket">TEMA</div>
      <div class="siralama" role="radiogroup" aria-label="Tema">
        <% for (const [deger, ad] of [["koyu", "Koyu"], ["acik", "Açık"], ["sistem", "Sistem"]]) { %>
          <label><input type="radio" name="tema" value="<%= deger %>" <%= ayar.tema === deger ? "checked" : "" %>><%= ad %></label>
        <% } %>
      </div>
      <div class="ust-etiket">VURGU RENGİ</div>
      <div class="taslar" role="radiogroup" aria-label="Vurgu rengi">
        <% for (const [deger, ad] of [["safir", "Safir"], ["zumrut", "Zümrüt"], ["kehribar", "Kehribar"], ["ametist", "Ametist"], ["yakut", "Yakut"]]) { %>
          <label data-vurgu="<%= deger %>"><input type="radio" name="vurgu" value="<%= deger %>" <%= ayar.vurgu === deger ? "checked" : "" %>><span class="tas"></span><%= ad %></label>
        <% } %>
      </div>
      <div class="ust-etiket">+18 İÇERİK</div>
      <p class="ikincil kucuk">Yazarın ya da moderatörün +18 işaretlediği fotoğraf ve videolar nasıl görünsün? Çıkış yapmışsan her zaman gizli görünür.</p>
      <div class="nsfw-secenekler" role="radiogroup" aria-label="+18 içerik">
        <% for (const [deger, ad, aciklama] of [["gizle", "Gizle", "Yerine kısa bir not görünür."], ["bulanik", "Bulanık", "Bulanık görünür, istersen tek dokunuşla açarsın."], ["goster", "Göster", "Normal görünür, köşede küçük +18 işareti olur."]]) { %>
          <label class="nsfw-secenek"><input type="radio" name="nsfw_tercih" value="<%= deger %>" <%= (ayar.nsfw_tercih || "bulanik") === deger ? "checked" : "" %>><span><strong><%= ad %></strong><span class="ikincil kucuk"><%= aciklama %></span></span></label>
        <% } %>
      </div>
      <hr class="ayirici">
      <% for (const [alan, baslik, aciklama] of [
        ["menu_sagda", "Menüyü sağa al", "Tablette kenar menüsü sağ tarafta durur. Solaklar ve sağ elle tutanlar için."],
        ["kompakt", "Kompakt kartlar", "Akışta kartlar daha az yer kaplar, özet gizlenir."],
        ["az_animasyon", "Animasyonları azalt", "Açılır menüler, pencereler, bildirimler ve geçiş efektleri animasyonsuz, anında açılır ve kapanır."]]) { %>
        <label class="ayar-satiri anahtar">
          <div><strong><%= baslik %></strong><span class="ikincil kucuk"><%= aciklama %></span></div>
          <input type="checkbox" name="<%= alan %>" value="1" <%= ayar[alan] ? "checked" : "" %>><span class="ray"></span>
        </label>
      <% } %>
      <div class="satir" style="justify-content: flex-end"><button class="buton buton-birincil">Kaydet</button></div>
    </form>

    <section class="kart bolum" id="gizlilik">
      <div><h2>Gizlilik</h2><p class="ikincil kucuk">Sana kimlerin yazabileceğini ve nasıl göründüğünü belirle</p></div>
      <form class="bolum-ici" method="post" action="/ayarlar/gizlilik"><input type="hidden" name="_csrf" value="<%= locals.csrf %>">
        <div class="ust-etiket">ÖZEL MESAJLARI KİMDEN AL</div>
        <label class="alan"><span class="arama-gizli-baslik">Özel mesajları kimden al</span>
          <select name="dm_izni">
            <option value="herkes" <%= (ayar.dm_izni || "herkes") === "herkes" ? "selected" : "" %>>Herkesten</option>
            <option value="kimse" <%= ayar.dm_izni === "kimse" ? "selected" : "" %>>Kimseden</option>
          </select>
        </label>
        <label class="ayar-satiri anahtar">
          <div><strong>Çevrimiçi durumumu göster</strong><span class="ikincil kucuk">Kapalıysa sohbetteki çevrimiçi listesinde ve mesajlarda görünmezsin.</span></div>
          <input type="checkbox" name="cevrimici_goster" value="1" <%= ayar.cevrimici_goster !== false ? "checked" : "" %>><span class="ray"></span>
        </label>
        <div class="satir" style="justify-content: flex-end"><button class="buton buton-birincil">Kaydet</button></div>
      </form>
      <hr class="ayirici">
      <div class="engelliler">
        <div class="ust-etiket">ENGELLENENLER</div>
        <% const engelliler_ = ayar.engelliler || []; %>
        <% if (engelliler_.length === 0) { %>
          <p class="ikincil kucuk">Kimseyi engellemedin. Bir kullanıcıyı profilinden ya da mesaj ekranındaki ⋮ menüsünden engelleyebilirsin.</p>
        <% } else { %>
          <ul class="engelli-liste">
            <% for (const e of engelliler_) { %>
              <li class="engelli-satir">
                <%- include("partials/avatar", { ad: e.username, sinif: "avatar-36", bos: true }) %>
                <strong><%= e.username %></strong>
                <form method="post" action="/engel/<%= encodeURIComponent(e.username) %>/kaldir"><input type="hidden" name="_csrf" value="<%= locals.csrf %>">
                  <button class="buton buton-cerceveli">Engeli kaldır</button>
                </form>
              </li>
            <% } %>
          </ul>
        <% } %>
      </div>
    </section>

    <section class="kart bolum" id="hesap">
      <div><h2>Hesap ve güvenlik</h2><p class="ikincil kucuk">Sadece sen görürsün</p></div>
      <div class="ayar-satiri"><div><strong>E-posta</strong><span class="ikincil kucuk"><%= ayar.email %></span></div><a class="buton buton-cerceveli" href="/hesap/eposta">Değiştir</a></div>
      <hr class="ayirici">
      <div class="ayar-satiri"><div><strong>Şifre</strong><span class="ikincil kucuk">Güçlü ve başka yerde kullanmadığın bir şifre seç</span></div><a class="buton buton-cerceveli" href="/hesap/sifre">Şifreyi değiştir</a></div>
      <hr class="ayirici">
      <form class="ayar-satiri tehlike" method="post" action="/hesap/sil"><input type="hidden" name="_csrf" value="<%= locals.csrf %>">
        <div><strong>Hesabı sil</strong><span class="ikincil kucuk">Hesabın kapatılır, gönderilerin “silinmiş kullanıcı” adıyla kalır.</span></div>
        <button class="buton buton-tehlikeli">Hesabı sil</button>
      </form>
    </section>
  </div>
</div>
<%- include("partials/son", { ayarSayfasi: true }) %>
